        "cvssV20__authentication",
        "cvssV20__exploitability",
        "cvssV20__collateralDamagePotential",
        "cvssV20__targetDistribution"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "accessVector",
          "annotations": [
            {
              "tag": "upstream_path",
              "value": "imports/cvss/cvss-v2.0.json#/properties/accessVector",
              "@type": "Annotation"
            }
          ],
          "description": "How far away an attacker can be when using the flaw, in CVSS 2.0's terms.",
          "close_mappings": [
            "sepses_cvss:accessVector"
          ],
          "range": "CvssV2AccessVector",
          "@type": "SlotDefinition"
        },
        {
          "name": "accessComplexity",
          "annotations": [
            {
              "tag": "upstream_path",
              "value": "imports/cvss/cvss-v2.0.json#/properties/accessComplexity",
              "@type": "Annotation"
            }
          ],
          "description": "How hard the flaw is to use once the attacker can reach it.",
          "close_mappings": [
            "sepses_cvss:accessComplexity"
          ],
          "range": "CvssV2AccessComplexity",
          "@type": "SlotDefinition"
        },
        {
          "name": "authentication",
          "annotations": [
            {
              "tag": "upstream_path",
              "value": "imports/cvss/cvss-v2.0.json#/properties/authentication",
              "@type": "Annotation"
            }
          ],
          "description": "How many times an attacker must log in before using the flaw.",
          "close_mappings": [
            "sepses_cvss:authentication"
          ],
          "range": "CvssV2Authentication",
          "@type": "SlotDefinition"
        },
        {
          "name": "exploitability",
          "annotations": [
            {
              "tag": "upstream_path",
              "value": "imports/cvss/cvss-v2.0.json#/properties/exploitability",
              "@type": "Annotation"
            }
          ],
          "description": "How far working attack code has come, in CVSS 2.0's terms.",
          "range": "CvssExploitCodeMaturity",
          "@type": "SlotDefinition"
        },
        {
          "name": "collateralDamagePotential",
          "annotations": [
            {
              "tag": "upstream_path",
              "value": "imports/cvss/cvss-v2.0.json#/properties/collateralDamagePotential",
              "@type": "Annotation"
            }
          ],
          "description": "How much loss a successful attack could cause beyond the system itself.",
          "range": "CvssV2CollateralDamagePotential",
          "@type": "SlotDefinition"
        },
        {
          "name": "targetDistribution",
          "annotations": [
            {
              "tag": "upstream_path",
              "value": "imports/cvss/cvss-v2.0.json#/properties/targetDistribution",
              "@type": "Annotation"
            }
          ],
          "description": "How much of the scorer's environment is exposed to the flaw.",
          "range": "CvssV2TargetDistribution",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/cve/CvssV20",
      "@type": "ClassDefinition"
    },
