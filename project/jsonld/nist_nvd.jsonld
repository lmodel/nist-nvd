{
  "name": "nist_nvd",
  "annotations": [
    {
      "tag": "upstream_sha256",
      "value": "2b9c4e8ab7e6e42aa17ea787f58167beff47c119c6f291405f86ac19c6149e01"
    }
  ],
  "description": "A LinkML model of the JSON responses of the NVD API 2.0, from the JSON schemas NIST publishes: vulnerabilities, products, match strings and change history. NVD's own keys are the schema's keys, so a real response validates unchanged.",
  "title": "National Vulnerability Database (NVD)",
  "comments": [
    "The version is the edition of NVD's vulnerability schema, as its title names it. Each module's header carries the edition of its own schema: 2.0 for the product and match-string responses, and 2.0.1 for the change history. scripts/check_upstream_release.py compares each file's SHA-256 with its pin, since NIST changes them in place with no release.",
    "NVD has four kinds of response and no document that holds them, so each response module marks its own response as a tree root, and the generators write NvdCveResponse as the top class. Name the kind when validating, with linkml-validate -C NvdCpeResponse."
  ],
  "source": "https://csrc.nist.gov/schema/nvd/api/2.0/cve_api_json_2.0.schema",
  "see_also": [
    "https://lmodel.github.io/nist-nvd",
    "https://nvd.nist.gov/developers/start-here"
  ],
  "id": "https://w3id.org/lmodel/nist-nvd",
  "version": "2.2.4",
  "imports": [
    "linkml:types",
    "./nvd_core",
    "./nvd_cve",
    "./nvd_cpe",
    "./nvd_cpematch",
    "./nvd_history",
    "cve/cve_cvss"
  ],
  "license": "Apache-2.0",
  "prefixes": [
    {
      "prefix_prefix": "linkml",
      "prefix_reference": "https://w3id.org/linkml/"
    },
    {
      "prefix_prefix": "nist_nvd",
      "prefix_reference": "https://w3id.org/lmodel/nist-nvd/"
    }
  ],
  "default_prefix": "nist_nvd",
  "default_range": "string",
  "types": [
    {
      "name": "string",
      "definition_uri": "https://w3id.org/linkml/String",
      "description": "A character string",
      "notes": [
        "In RDF serializations, a slot with range of string is treated as a literal or type xsd:string. If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"string\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "exact_mappings": [
        "schema:Text"
      ],
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "@type": "TypeDefinition"
    },
    {
      "name": "integer",
      "definition_uri": "https://w3id.org/linkml/Integer",
      "description": "An integer",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"integer\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "exact_mappings": [
        "schema:Integer"
      ],
      "base": "int",
      "uri": "http://www.w3.org/2001/XMLSchema#integer",
      "@type": "TypeDefinition"
    },
    {
      "name": "boolean",
      "definition_uri": "https://w3id.org/linkml/Boolean",
      "description": "A binary (true or false) value",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"boolean\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "exact_mappings": [
        "schema:Boolean"
      ],
      "base": "Bool",
      "uri": "http://www.w3.org/2001/XMLSchema#boolean",
      "repr": "bool",
      "@type": "TypeDefinition"
    },
    {
      "name": "float",
      "definition_uri": "https://w3id.org/linkml/Float",
      "description": "A real number that conforms to the xsd:float specification",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"float\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "exact_mappings": [
        "schema:Float"
      ],
      "base": "float",
      "uri": "http://www.w3.org/2001/XMLSchema#float",
      "@type": "TypeDefinition"
    },
    {
      "name": "double",
      "definition_uri": "https://w3id.org/linkml/Double",
      "description": "A real number that conforms to the xsd:double specification",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"double\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "close_mappings": [
        "schema:Float"
      ],
      "base": "float",
      "uri": "http://www.w3.org/2001/XMLSchema#double",
      "@type": "TypeDefinition"
    },
    {
      "name": "decimal",
      "definition_uri": "https://w3id.org/linkml/Decimal",
      "description": "A real number with arbitrary precision that conforms to the xsd:decimal specification",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"decimal\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "broad_mappings": [
        "schema:Number"
      ],
      "base": "Decimal",
      "uri": "http://www.w3.org/2001/XMLSchema#decimal",
      "@type": "TypeDefinition"
    },
    {
      "name": "time",
      "definition_uri": "https://w3id.org/linkml/Time",
      "description": "A time object represents a (local) time of day, independent of any particular day",
      "notes": [
        "URI is dateTime because OWL reasoners do not work with straight date or time",
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"time\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "exact_mappings": [
        "schema:Time"
      ],
      "base": "XSDTime",
      "uri": "http://www.w3.org/2001/XMLSchema#time",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "date",
      "definition_uri": "https://w3id.org/linkml/Date",
      "description": "a date (year, month and day) in an idealized calendar",
      "notes": [
        "URI is dateTime because OWL reasoners don't work with straight date or time",
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"date\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "exact_mappings": [
        "schema:Date"
      ],
      "base": "XSDDate",
      "uri": "http://www.w3.org/2001/XMLSchema#date",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "datetime",
      "definition_uri": "https://w3id.org/linkml/Datetime",
      "description": "The combination of a date and time",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"datetime\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "exact_mappings": [
        "schema:DateTime"
      ],
      "base": "XSDDateTime",
      "uri": "http://www.w3.org/2001/XMLSchema#dateTime",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "date_or_datetime",
      "definition_uri": "https://w3id.org/linkml/DateOrDatetime",
      "description": "Either a date or a datetime",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"date_or_datetime\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "str",
      "uri": "https://w3id.org/linkml/DateOrDatetime",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "uriorcurie",
      "definition_uri": "https://w3id.org/linkml/Uriorcurie",
      "description": "a URI or a CURIE",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"uriorcurie\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "URIorCURIE",
      "uri": "http://www.w3.org/2001/XMLSchema#anyURI",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "curie",
      "definition_uri": "https://w3id.org/linkml/Curie",
      "conforms_to": "https://www.w3.org/TR/curie/",
      "description": "a compact URI",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"curie\"."
      ],
      "comments": [
        "in RDF serializations this MUST be expanded to a URI",
        "in non-RDF serializations MAY be serialized as the compact representation"
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "Curie",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "uri",
      "definition_uri": "https://w3id.org/linkml/Uri",
      "conforms_to": "https://www.ietf.org/rfc/rfc3987.txt",
      "description": "a complete URI",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"uri\"."
      ],
      "comments": [
        "in RDF serializations a slot with range of uri is treated as a literal or type xsd:anyURI unless it is an identifier or a reference to an identifier, in which case it is translated directly to a node"
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "close_mappings": [
        "schema:URL"
      ],
      "base": "URI",
      "uri": "http://www.w3.org/2001/XMLSchema#anyURI",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "ncname",
      "definition_uri": "https://w3id.org/linkml/Ncname",
      "description": "Prefix part of CURIE",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"ncname\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "NCName",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "objectidentifier",
      "definition_uri": "https://w3id.org/linkml/Objectidentifier",
      "description": "A URI or CURIE that represents an object in the model.",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"objectidentifier\"."
      ],
      "comments": [
        "Used for inheritance and type checking"
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "ElementIdentifier",
      "uri": "http://www.w3.org/ns/shex#iri",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "nodeidentifier",
      "definition_uri": "https://w3id.org/linkml/Nodeidentifier",
      "description": "A URI, CURIE or BNODE that represents a node in a model.",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"nodeidentifier\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "NodeIdentifier",
      "uri": "http://www.w3.org/ns/shex#nonLiteral",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "jsonpointer",
      "definition_uri": "https://w3id.org/linkml/Jsonpointer",
      "conforms_to": "https://datatracker.ietf.org/doc/html/rfc6901",
      "description": "A string encoding a JSON Pointer. The value of the string MUST conform to JSON Point syntax and SHOULD dereference to a valid object within the current instance document when encoded in tree form.",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"jsonpointer\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "jsonpath",
      "definition_uri": "https://w3id.org/linkml/Jsonpath",
      "conforms_to": "https://www.ietf.org/archive/id/draft-goessner-dispatch-jsonpath-00.html",
      "description": "A string encoding a JSON Path. The value of the string MUST conform to JSON Point syntax and SHOULD dereference to zero or more valid objects within the current instance document when encoded in tree form.",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"jsonpath\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "sparqlpath",
      "definition_uri": "https://w3id.org/linkml/Sparqlpath",
      "conforms_to": "https://www.w3.org/TR/sparql11-query/#propertypaths",
      "description": "A string encoding a SPARQL Property Path. The value of the string MUST conform to SPARQL syntax and SHOULD dereference to zero or more valid objects within the current instance document when encoded as RDF.",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"sparqlpath\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "nvd_timestamp",
      "definition_uri": "https://w3id.org/lmodel/nist-nvd/NvdTimestamp",
      "description": "A date and time as NVD writes it: ISO 8601, with fractional seconds and a UTC offset where the writer gives them.",
      "comments": [
        "NVD's schemas say format date-time, which is RFC 3339 and needs a UTC offset. NVD's records and responses write none, so a validator that checks the format refuses every real record. This type admits both forms, and tests/test_upstream.py lists the departure."
      ],
      "from_schema": "https://w3id.org/lmodel/nist-nvd/nvd_core",
      "typeof": "string",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#dateTime",
      "pattern": "^[0-9]{4}-(0[1-9]|1[012])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})?$",
      "@type": "TypeDefinition"
    },
    {
      "name": "nvd_uuid",
      "definition_uri": "https://w3id.org/lmodel/nist-nvd/NvdUuid",
      "description": "A UUID in its usual hexadecimal form with four hyphens.",
      "comments": [
        "NVD's schemas say format uuid, and LinkML has no such type. NVD writes these in capitals."
      ],
      "from_schema": "https://w3id.org/lmodel/nist-nvd/nvd_core",
      "typeof": "string",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "@type": "TypeDefinition"
    },
    {
      "name": "nvd_cve_identifier",
      "definition_uri": "https://w3id.org/lmodel/nist-nvd/NvdCveIdentifier",
      "description": "A CVE identifier, such as CVE-2021-44228.",
      "from_schema": "https://w3id.org/lmodel/nist-nvd/nvd_core",
      "typeof": "string",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$",
      "@type": "TypeDefinition"
    }
  ],
  "enums": [
    {
      "name": "NvdVulnStatus",
      "definition_uri": "https://w3id.org/lmodel/nist-nvd/NvdVulnStatus",
      "description": "Where a vulnerability stands in NVD's own analysis.",
      "comments": [
        "NVD's schema says only that vulnStatus is a string. This list comes from the data: the seven values of the 33,378 records read on 2026-11-03, which are the modified feed, the records the API marks as known exploited, and eight pages of its results spread across all its years. NVD's page that defines them refuses a plain client, so each description says only what the value's name and the data show. A new value fails validation, and the feed test reports it."
      ],
      "from_schema": "https://w3id.org/lmodel/nist-nvd/nvd_cve",
      "permissible_values": [
        {
          "text": "Analyzed",
          "description": "NVD has finished its analysis of the record."
        },
        {
          "text": "Deferred",
          "description": "NVD has put off analysing the record."
        },
        {
          "text": "Awaiting Analysis",
          "description": "NVD has the record and has not begun to analyse it."
        },
        {
          "text": "Modified",
          "description": "The record has changed since NVD analysed it."
        },
        {
          "text": "Received",
          "description": "The record has just reached NVD."
        },
        {
          "text": "Undergoing Analysis",
          "description": "NVD is analysing the record now."
        },
        {
          "text": "Rejected",
          "description": "The CVE identifier has been rejected."
        }
      ]
    },
    {
      "name": "NvdCveTagName",
      "definition_uri": "https://w3id.org/lmodel/nist-nvd/NvdCveTagName",
      "description": "A label that a CVE record's source puts on the record.",
      "from_schema": "https://w3id.org/lmodel/nist-nvd/nvd_cve",
      "permissible_values": [
        {
          "text": "unsupported-when-assigned",
          "description": "The product had lost its support when the identifier was assigned."
        },
        {
          "text": "exclusively-hosted-service",
          "description": "The product exists only as a hosted service."
        },
        {
          "text": "disputed",
          "description": "A party disputes that this is a vulnerability."
        }
      ]
    },
    {
      "name": "NvdReferenceTag",
      "definition_uri": "https://w3id.org/lmodel/nist-nvd/NvdReferenceTag",
      "description": "NVD's label for what a reference is.",
      "comments": [
        "NVD's schema says only that a tag is a string. This list comes from the data, the same 33,378 records as NvdVulnStatus. A new value fails validation, and the feed test reports it.",
        "This is NVD's own vocabulary, not the CVE Program's reference tags, which differ in spelling and in membership. The two lists are not mapped to each other, and tests/test_mappings.py holds that."
      ],
      "from_schema": "https://w3id.org/lmodel/nist-nvd/nvd_cve",
      "permissible_values": [
        {
          "text": "Broken Link",
          "description": "The address no longer leads to the content."
        },
        {
          "text": "Exploit",
          "description": "The page shows or gives a way to exploit the vulnerability."
        },
        {
          "text": "Issue Tracking",
          "description": "An entry in a bug or issue tracker."
        },
        {
          "text": "Mailing List",
          "description": "A message in a mailing list archive."
        },
        {
          "text": "Mitigation",
          "description": "The page says how to reduce the risk without a fix."
        },
        {
          "text": "Not Applicable",
          "description": "The page does not bear on the vulnerability."
        },
        {
          "text": "Patch",
          "description": "The page holds or points to a fix."
        },
        {
          "text": "Permissions Required",
          "description": "Reading the page takes an account or some other access."
        },
        {
          "text": "Press/Media Coverage",
          "description": "A report in the press or other media."
        },
        {
          "text": "Related",
          "description": "A page on a related matter."
        },
        {
          "text": "Product",
          "description": "A page about the affected product."
        },
        {
          "text": "Release Notes",
          "description": "The notes of a product release."
        },
        {
          "text": "Technical Description",
          "description": "A technical account of the vulnerability."
        },
        {
          "text": "Third Party Advisory",
          "description": "An advisory from someone other than the vendor."
        },
        {
          "text": "Tool Signature",
          "description": "A signature that a detection tool can use."
        },
        {
          "text": "URL Repurposed",
          "description": "The address now leads to something else."
        },
        {
          "text": "US Government Resource",
          "description": "A page from a body of the United States government."
        },
        {
          "text": "VDB Entry",
          "description": "An entry in a vulnerability database."
        },
        {
          "text": "Vendor Advisory",
          "description": "An advisory from the product's vendor."
        }
      ]
    },
    {
      "name": "NvdSourceType",
      "definition_uri": "https://w3id.org/lmodel/nist-nvd/NvdSourceType",
      "description": "Whether a score or a weakness comes from the party NVD treats as first.",
      "comments": [
        "NVD's schema fixes this list for a score. For a weakness it says only string, and the data holds the same two values."
      ],
      "from_schema": "https://w3id.org/lmodel/nist-nvd/nvd_cve",
      "permissible_values": [
        {
          "text": "Primary",
          "description": "NVD's first source for the record."
        },
        {
          "text": "Secondary",
          "description": "Any other source."
        }
      ]
    },
    {
      "name": "NvdCvssV2Severity",
      "definition_uri": "https://w3id.org/lmodel/nist-nvd/NvdCvssV2Severity",
      "description": "The severity band NVD gives a CVSS 2.0 base score.",
      "comments": [
        "NVD's schema says only that this is a string. The data holds these three values, in the same 33,378 records as NvdVulnStatus."
      ],
      "from_schema": "https://w3id.org/lmodel/nist-nvd/nvd_cve",
      "permissible_values": [
        {
          "text": "LOW",
          "description": "The low band of CVSS 2.0 base scores."
        },
        {
          "text": "MEDIUM",
          "description": "The middle band of CVSS 2.0 base scores."
        },
        {
          "text": "HIGH",
          "description": "The high band of CVSS 2.0 base scores."
        }
      ]
    },
    {
      "name": "NvdVersionStatus",
      "definition_uri": "https://w3id.org/lmodel/nist-nvd/NvdVersionStatus",
      "description": "Whether a version of a product has the vulnerability.",
      "from_schema": "https://w3id.org/lmodel/nist-nvd/nvd_cve",
      "permissible_values": [
        {
          "text": "affected",
          "description": "This version has the vulnerability."
        },
        {
          "text": "unaffected",
          "description": "This version does not have the vulnerability."
        },
        {
          "text": "unknown",
          "description": "Nobody has said whether this version has the vulnerability."
        }
      ]
    },
    {
      "name": "NvdOperator",
      "definition_uri": "https://w3id.org/lmodel/nist-nvd/NvdOperator",
      "description": "How the parts of a configuration combine.",
      "from_schema": "https://w3id.org/lmodel/nist-nvd/nvd_cve",
      "permissible_values": [
        {
