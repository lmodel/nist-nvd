      "definition_uri": "https://w3id.org/lmodel/nist-nvd/NvdLangString",
      "annotations": [
        {
          "tag": "upstream_definition",
          "value": "cve_api_json_2.0.schema#/definitions/lang_string",
          "@type": "Annotation"
        }
      ],
      "description": "A piece of text and the language it is in.",
      "from_schema": "https://w3id.org/lmodel/nist-nvd/nvd_cve",
