      "from_schema": "https://w3id.org/lmodel/nist-nvd/nvd_cve",
      "aliases": [
        "cvss-v2"
      ],
      "close_mappings": [
        "sepses_cvss:CVSS2BaseMetric"
      ],
      "related_mappings": [
        "spdx3:Security/CvssV2VulnAssessmentRelationship"
      ],
      "slots": [
        "NvdCvssMetricV2_source",
        "NvdCvssMetricV2_type",
        "NvdCvssMetricV2_cvssData",
        "exploitabilityScore",
        "impactScore",
        "nvdCvssMetricV2__baseSeverity",
        "nvdCvssMetricV2__acInsufInfo",
        "nvdCvssMetricV2__obtainAllPrivilege",
        "nvdCvssMetricV2__obtainUserPrivilege",
        "nvdCvssMetricV2__obtainOtherPrivilege",
        "nvdCvssMetricV2__userInteractionRequired"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "baseSeverity",
