          "tag": "upstream_definition",
          "value": "cve_api_json_2.0.schema#/definitions/cve_item/properties/metrics",
          "@type": "Annotation"
        }
      ],
      "description": "The scores of a vulnerability, in a list per scoring system and version.",
      "from_schema": "https://w3id.org/lmodel/nist-nvd/nvd_cve",
      "slots": [
        "nvdMetrics__cvssMetricV40",
        "nvdMetrics__cvssMetricV31",
        "nvdMetrics__cvssMetricV30",
        "nvdMetrics__cvssMetricV2",
        "nvdMetrics__ssvcV203"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "cvssMetricV40",
          "description": "The CVSS 4.0 scores.",
          "range": "NvdCvssMetricV40",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "cvssMetricV31",
          "description": "The CVSS 3.1 scores.",
          "range": "NvdCvssMetricV31",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "cvssMetricV30",
          "description": "The CVSS 3.0 scores.",
          "range": "NvdCvssMetricV30",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "cvssMetricV2",
