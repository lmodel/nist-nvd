      "alias": "version",
      "owner": "CvssV40",
      "domain_of": [
        "CvssV40"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "version",
      "range": "string",
      "required": true,
      "equals_string": "4.0",
      "@type": "SlotDefinition"
    },
