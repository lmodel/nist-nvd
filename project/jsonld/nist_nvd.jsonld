      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "ref",
          "description": "The page's address.",
          "comments": [
            "NVD's own pattern, with its single quote written as \\x27, which means the same. gen-python cuts a raw string at a single quote."
          ],
          "required": true,
          "pattern": "^([A-Za-z][A-Za-z0-9+.-]+):(\\/\\/([^@]+@)?([A-Za-z0-9.\\-_~]+)(:\\d+)?)?((?:[A-Za-z0-9-._~]|%[A-Fa-f0-9]|[!$&\\x27\\[\\]()*+,;=:@])+(?:\\/(?:[A-Za-z0-9-._~]|%[A-Fa-f0-9]|[!$&\\x27\\[\\]()*+,;=:@])*)*|(?:\\/(?:[A-Za-z0-9-._~]|%[A-Fa-f0-9]|[!$&\\x27()*+,;=:@])+)*)?(\\?(?:[A-Za-z0-9-._~]|%[A-Fa-f0-9]|[!$&\\x27\\[\\]()*+,;=:@]|[/?])*)?(\\#(?:[A-Za-z0-9-._~]|%[A-Fa-f0-9]|[!$&\\x27\\[\\]()*+,;=:@]|[/?])*)?$",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/nist-nvd/NvdCpeReference",
      "@type": "ClassDefinition"
    },
