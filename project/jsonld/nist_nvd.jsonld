  "classes": [
    {
      "name": "NvdResponseMixin",
      "definition_uri": "https://w3id.org/lmodel/nist-nvd/NvdResponseMixin",
      "description": "The fields of a page of results, which every NVD API response carries.",
      "from_schema": "https://w3id.org/lmodel/nist-nvd/nvd_core",
      "mixin": true,
      "slots": [
        "format",
        "NvdResponseMixin_timestamp",
        "nvdResponseMixin__resultsPerPage",
        "nvdResponseMixin__startIndex",
        "nvdResponseMixin__totalResults",
        "nvdResponseMixin__version"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "resultsPerPage",
          "description": "How many results this page holds.",
          "slot_uri": "nist_nvd:resultsPerPage",
          "range": "integer",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "startIndex",
          "description": "The position of this page's first result among all the results.",
          "slot_uri": "nist_nvd:startIndex",
          "range": "integer",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "totalResults",
          "description": "How many results the request matched in all.",
          "slot_uri": "nist_nvd:totalResults",
          "range": "integer",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "version",
          "description": "The version of the response format.",
          "slot_uri": "nist_nvd:responseVersion",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/nist-nvd/NvdResponseMixin",
      "@type": "ClassDefinition"
    },
    {
      "name": "NvdCveResponse",
      "definition_uri": "https://w3id.org/lmodel/nist-nvd/NvdCveResponse",
      "annotations": [
        {
          "tag": "upstream_definition",
          "value": "cve_api_json_2.0.schema#",
          "@type": "Annotation"
        }
      ],
      "description": "A page of the vulnerability API's results, or a whole data feed.",
      "comments": [
        "A feed file is one representation of NVD's data, so it relates to a DCAT distribution, but this class also covers one page of an API answer."
      ],
      "from_schema": "https://w3id.org/lmodel/nist-nvd/nvd_cve",
      "close_mappings": [
        "schema:DataFeed"
      ],
      "related_mappings": [
        "dcat:Distribution"
      ],
      "mixins": [
        "NvdResponseMixin"
      ],
      "slots": [
        "nvdCveResponse__vulnerabilities",
        "NvdCveResponse_format",
        "NvdResponseMixin_timestamp",
        "nvdResponseMixin__resultsPerPage",
        "nvdResponseMixin__startIndex",
        "nvdResponseMixin__totalResults",
        "nvdResponseMixin__version"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "vulnerabilities",
          "description": "The vulnerabilities on this page.",
          "range": "NvdVulnerability",
          "required": true,
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/nist-nvd/NvdCveResponse",
      "tree_root": true,
      "@type": "ClassDefinition"
    },
    {
      "name": "NvdVulnerability",
      "definition_uri": "https://w3id.org/lmodel/nist-nvd/NvdVulnerability",
      "annotations": [
        {
          "tag": "upstream_definition",
          "value": "cve_api_json_2.0.schema#/definitions/def_cve_item",
          "@type": "Annotation"
        }
      ],
      "description": "One entry of a response, which only wraps the vulnerability.",
      "from_schema": "https://w3id.org/lmodel/nist-nvd/nvd_cve",
      "aliases": [
        "def_cve_item"
      ],
      "close_mappings": [
        "schema:DataFeedItem"
      ],
      "slots": [
        "nvdVulnerability__cve"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "cve",
          "description": "The vulnerability.",
          "range": "NvdCve",
          "required": true,
          "inlined": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/nist-nvd/NvdVulnerability",
      "@type": "ClassDefinition"
    },
    {
      "name": "NvdCve",
      "definition_uri": "https://w3id.org/lmodel/nist-nvd/NvdCve",
      "annotations": [
        {
          "tag": "upstream_definition",
          "value": "cve_api_json_2.0.schema#/definitions/cve_item",
          "@type": "Annotation"
        }
      ],
      "description": "A vulnerability as NVD holds it, under its CVE identifier.",
      "comments": [
        "NVD republishes CVE records and adds its own analysis, so this is close to a CVE record and not the same thing. A record of this class also repeats four fields of the CISA Known Exploited Vulnerabilities catalog when the catalog lists it."
      ],
      "from_schema": "https://w3id.org/lmodel/nist-nvd/nvd_cve",
      "aliases": [
        "cve_item"
      ],
      "close_mappings": [
        "cve:CveRecord",
        "stix:StixVulnerability",
        "spdx3:Security/Vulnerability",
        "sepses_cve:CVE",
        "wd:Q631425"
      ],
      "slots": [
        "id",
        "sourceIdentifier",
        "NvdCve_lastModified",
        "references",
        "nvdCve__vulnStatus",
        "nvdCve__published",
        "nvdCve__evaluatorComment",
        "nvdCve__evaluatorSolution",
        "nvdCve__evaluatorImpact",
        "nvdCve__cisaExploitAdd",
        "nvdCve__cisaActionDue",
        "nvdCve__cisaRequiredAction",
        "nvdCve__cisaVulnerabilityName",
        "nvdCve__cveTags",
        "nvdCve__descriptions",
        "nvdCve__metrics",
        "nvdCve__affected",
        "nvdCve__weaknesses",
        "nvdCve__configurations",
        "nvdCve__vendorComments"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "vulnStatus",
          "description": "Where this vulnerability stands in NVD's analysis.",
          "range": "NvdVulnStatus",
          "@type": "SlotDefinition"
        },
        {
          "name": "published",
          "description": "When NVD published this vulnerability.",
          "comments": [
            "This is NVD's own time, not the CVE record's datePublished. For CVE-2021-44228 the CVE record says 2021-12-10T00:00:00.000Z and NVD 2021-12-10T10:15:09.143, so the mapping is only a related one."
          ],
          "close_mappings": [
            "dcterms:issued",
            "schema:datePublished",
            "spdx3:Security/publishedTime"
          ],
          "related_mappings": [
            "cve:datePublished"
          ],
          "range": "nvd_timestamp",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "evaluatorComment",
          "description": "A remark from NVD's analyst.",
          "@type": "SlotDefinition"
        },
        {
          "name": "evaluatorSolution",
          "description": "A way to resolve the vulnerability, from NVD's analyst.",
          "@type": "SlotDefinition"
        },
        {
          "name": "evaluatorImpact",
          "description": "What the vulnerability can lead to, from NVD's analyst.",
          "@type": "SlotDefinition"
        },
        {
          "name": "cisaExploitAdd",
          "description": "The day CISA added this vulnerability to its Known Exploited Vulnerabilities catalog.",
          "comments": [
            "Equal to the catalog's value for all 1,766 entries of the catalog of 2026-11-03, read through the API."
          ],
          "exact_mappings": [
            "kev_catalog:dateAdded"
          ],
          "range": "date",
          "@type": "SlotDefinition"
        },
        {
          "name": "cisaActionDue",
          "description": "The day by which CISA says federal agencies must act.",
          "comments": [
            "Equal to the catalog's value for all 1,766 entries of the catalog of 2026-11-03, read through the API."
          ],
          "exact_mappings": [
            "kev_catalog:dueDate"
          ],
          "range": "date",
          "@type": "SlotDefinition"
        },
        {
          "name": "cisaRequiredAction",
          "description": "What CISA says agencies must do about this vulnerability.",
          "comments": [
            "Equal to the catalog's value for all 1,766 entries of the catalog of 2026-11-03, read through the API."
          ],
          "exact_mappings": [
            "kev_catalog:requiredAction"
          ],
          "@type": "SlotDefinition"
        },
        {
          "name": "cisaVulnerabilityName",
          "description": "The name CISA gives this vulnerability in its catalog.",
          "comments": [
            "Equal to the catalog's value for all 1,766 entries of the catalog of 2026-11-03, read through the API."
          ],
          "exact_mappings": [
            "kev_catalog:vulnerabilityName"
          ],
          "@type": "SlotDefinition"
        },
        {
          "name": "cveTags",
          "description": "The labels the record's sources put on it.",
          "close_mappings": [
            "cve:tags"
          ],
          "range": "NvdCveTag",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "descriptions",
          "description": "What the vulnerability is, in one or more languages.",
          "close_mappings": [
            "cve:descriptions"
          ],
          "range": "NvdLangString",
          "required": true,
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "minimum_cardinality": 1,
          "@type": "SlotDefinition"
        },
        {
          "name": "metrics",
          "description": "The scores that NVD and others give this vulnerability.",
          "close_mappings": [
            "cve:metrics"
          ],
          "related_mappings": [
            "sepses_cvss:hasCVSS"
          ],
          "range": "NvdMetrics",
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "affected",
          "description": "The affected products, by the source that names them.",
          "close_mappings": [
            "cve:affected"
          ],
          "range": "NvdAffected",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "weaknesses",
          "description": "The weaknesses behind the vulnerability, by the source that names them.",
          "close_mappings": [
            "cve:problemTypes"
          ],
          "related_mappings": [
            "sepses_cve:hasCWE"
          ],
          "range": "NvdWeakness",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "configurations",
          "description": "The product configurations that have the vulnerability.",
          "close_mappings": [
            "cve:cpeApplicability",
            "sepses_cve:hasVulnerableConfiguration"
          ],
          "range": "NvdConfiguration",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "vendorComments",
          "description": "What product vendors have said about this vulnerability.",
          "range": "NvdVendorComment",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/nist-nvd/NvdCve",
      "@type": "ClassDefinition"
    },
    {
      "name": "NvdCveTag",
