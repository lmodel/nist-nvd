        "NvdMatchedCpe_cpeNameId"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/nist-nvd/NvdMatchedCpe",
      "@type": "ClassDefinition"
    },
    {
      "name": "NvdHistoryResponse",
      "definition_uri": "https://w3id.org/lmodel/nist-nvd/NvdHistoryResponse",
      "annotations": [
        {
          "tag": "upstream_definition",
          "value": "cve_history_api_json_2.0.schema#",
          "@type": "Annotation"
        }
      ],
      "description": "A page of the change-history API's results.",
      "from_schema": "https://w3id.org/lmodel/nist-nvd/nvd_history",
      "close_mappings": [
        "schema:DataFeed"
      ],
      "mixins": [
        "NvdResponseMixin"
      ],
      "slots": [
        "nvdHistoryResponse__cveChanges",
        "NvdHistoryResponse_format",
        "NvdResponseMixin_timestamp",
        "nvdResponseMixin__resultsPerPage",
        "nvdResponseMixin__startIndex",
        "nvdResponseMixin__totalResults",
        "nvdResponseMixin__version"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "cveChanges",
          "description": "The changes on this page.",
          "range": "NvdChangeItem",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/nist-nvd/NvdHistoryResponse",
      "tree_root": true,
      "@type": "ClassDefinition"
    },
    {
      "name": "NvdChangeItem",
      "definition_uri": "https://w3id.org/lmodel/nist-nvd/NvdChangeItem",
      "annotations": [
        {
          "tag": "upstream_definition",
          "value": "cve_history_api_json_2.0.schema#/definitions/defChange",
          "@type": "Annotation"
        }
      ],
      "description": "One entry of a change-history response, which only wraps the change.",
      "from_schema": "https://w3id.org/lmodel/nist-nvd/nvd_history",
      "aliases": [
        "defChange"
      ],
      "close_mappings": [
        "schema:DataFeedItem"
      ],
      "slots": [
        "nvdChangeItem__change"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "change",
          "description": "The change.",
          "range": "NvdChange",
          "required": true,
          "inlined": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/nist-nvd/NvdChangeItem",
      "@type": "ClassDefinition"
    },
    {
      "name": "NvdChange",
      "definition_uri": "https://w3id.org/lmodel/nist-nvd/NvdChange",
      "annotations": [
        {
          "tag": "upstream_definition",
          "value": "cve_history_api_json_2.0.schema#/definitions/changeItem",
          "@type": "Annotation"
        }
      ],
      "description": "One change to a vulnerability's record at NVD.",
      "comments": [
        "A change is something that happened to a record, so it relates to a PROV activity, but NVD records only when and by whom, not the entities it used."
      ],
      "from_schema": "https://w3id.org/lmodel/nist-nvd/nvd_history",
      "aliases": [
        "changeItem"
      ],
      "related_mappings": [
        "prov:Activity"
      ],
      "slots": [
        "NvdChange_sourceIdentifier",
        "created",
        "nvdChange__cveId",
        "nvdChange__eventName",
        "nvdChange__cveChangeId",
        "nvdChange__details"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "cveId",
          "description": "The vulnerability the change is to.",
          "range": "NvdCve",
          "required": true,
          "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$",
          "@type": "SlotDefinition"
        },
        {
          "name": "eventName",
          "description": "The kind of event, such as Initial Analysis or CVE Modified.",
          "comments": [
            "NVD's schema says only that this is a string. The samples read here hold too little of a list of 2.4 million changes to close it, so it stays a string."
          ],
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "cveChangeId",
          "description": "The UUID that NVD gives this change.",
          "identifier": true,
          "range": "nvd_uuid",
          "@type": "SlotDefinition"
        },
        {
          "name": "details",
          "description": "What the change did, part by part.",
          "range": "NvdChangeDetail",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/nist-nvd/NvdChange",
      "@type": "ClassDefinition"
    },
    {
      "name": "NvdChangeDetail",
      "definition_uri": "https://w3id.org/lmodel/nist-nvd/NvdChangeDetail",
      "annotations": [
        {
          "tag": "upstream_definition",
          "value": "cve_history_api_json_2.0.schema#/definitions/detail",
          "@type": "Annotation"
        }
      ],
      "description": "One part of a change, naming what kind of data changed and how.",
      "from_schema": "https://w3id.org/lmodel/nist-nvd/nvd_history",
      "aliases": [
        "detail"
      ],
      "slots": [
        "NvdChangeDetail_type",
        "nvdChangeDetail__action",
        "nvdChangeDetail__oldValue",
        "nvdChangeDetail__newValue"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "action",
          "description": "How the data changed, such as Added.",
          "@type": "SlotDefinition"
        },
        {
          "name": "oldValue",
          "description": "The value before the change.",
          "any_of": [
            {
              "range": "string",
              "@type": "AnonymousSlotExpression"
            },
            {
              "range": "string",
              "multivalued": true,
              "@type": "AnonymousSlotExpression"
            },
            {
              "range": "NvdChangeObject",
              "@type": "AnonymousSlotExpression"
            }
          ],
          "@type": "SlotDefinition"
        },
        {
          "name": "newValue",
          "description": "The value after the change.",
          "any_of": [
            {
              "range": "string",
              "@type": "AnonymousSlotExpression"
            },
            {
              "range": "string",
              "multivalued": true,
              "@type": "AnonymousSlotExpression"
            },
            {
              "range": "NvdChangeObject",
              "@type": "AnonymousSlotExpression"
            }
          ],
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/nist-nvd/NvdChangeDetail",
      "@type": "ClassDefinition"
    },
    {
      "name": "NvdChangeObject",
      "definition_uri": "https://w3id.org/lmodel/nist-nvd/NvdChangeObject",
      "description": "A value before or after a change that is an object, with any keys.",
      "comments": [
        "NVD's file allows a string, an array or an object as a value, and states nothing of the object's keys. The 1,335 values of the three pages read on 2026-11-03 are all strings, so no key is named here, and LinkML's Pydantic generator, which ignores extra_slots, would refuse an object."
      ],
      "from_schema": "https://w3id.org/lmodel/nist-nvd/nvd_history",
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/nist-nvd/NvdChangeObject",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "CvssSeverityBandsMixin",
      "definition_uri": "https://w3id.org/lmodel/cve/CvssSeverityBandsMixin",
      "annotations": [
        {
          "tag": "upstream_path",
          "value": "imports/cvss/cvss-v3.0.json#/anyOf imports/cvss/cvss-v3.1.json#/anyOf imports/cvss/cvss-v4.0.json#/allOf/0/anyOf",
          "@type": "Annotation"
        }
      ],
      "description": "The base score and base severity of a CVSS version with severity bands, and the bands that tie one to the other.",
      "comments": [
        "The upstream also rules out a score that is not a multiple of 0.1, as a list of numbers no LinkML range can state. tests/cve_rules.py checks that."
      ],
      "from_schema": "https://w3id.org/lmodel/cve/cve_cvss",
      "mixin": true,
      "slots": [
        "baseScore",
        "baseSeverity"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/cve/CvssSeverityBandsMixin",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "baseSeverity",
                "equals_string": "NONE",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "baseScore",
                "minimum_value": 0,
                "maximum_value": 0,
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "A base severity of NONE goes with a base score of exactly 0.",
          "title": "base severity NONE",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "baseSeverity",
                "equals_string": "LOW",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "baseScore",
                "minimum_value": 0.1,
                "maximum_value": 3.9,
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "A base severity of LOW goes with a base score from 0.1 to 3.9.",
          "title": "base severity LOW",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "baseSeverity",
                "equals_string": "MEDIUM",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "baseScore",
                "minimum_value": 4.0,
                "maximum_value": 6.9,
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "A base severity of MEDIUM goes with a base score from 4.0 to 6.9.",
          "title": "base severity MEDIUM",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "baseSeverity",
                "equals_string": "HIGH",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "baseScore",
                "minimum_value": 7.0,
                "maximum_value": 8.9,
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "A base severity of HIGH goes with a base score from 7.0 to 8.9.",
          "title": "base severity HIGH",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "baseSeverity",
                "equals_string": "CRITICAL",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "baseScore",
                "minimum_value": 9.0,
                "maximum_value": 10.0,
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "A base severity of CRITICAL goes with a base score from 9.0 to 10.",
          "title": "base severity CRITICAL",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "CvssV20",
      "definition_uri": "https://w3id.org/lmodel/cve/CvssV20",
      "annotations": [
        {
          "tag": "upstream_path",
          "value": "imports/cvss/cvss-v2.0.json#/",
          "@type": "Annotation"
        }
      ],
      "description": "A score under CVSS version 2.0, which has no severity bands.",
      "from_schema": "https://w3id.org/lmodel/cve/cve_cvss",
      "close_mappings": [
