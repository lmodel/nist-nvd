  "classes": [
    {
      "name": "NVDEntry",
      "definition_uri": "https://w3id.org/lmodel/nist-nvd/NVDEntry",
      "description": "Enriched NVD representation of a CVE entry.",
      "notes": [
        "If NVD and CNA CVSS values match, NVD displays only the CNA values.",
        "Rejected CVEs are determined by the CVE Program rather than NVD."
      ],
      "comments": [
        "Current Description is the currently visible CVE description.",
        "Analysis Description captures the description present when NVD enrichment occurred."
      ],
      "in_subset": [
        "nvd_feed",
        "detail_page"
      ],
      "from_schema": "https://w3id.org/lmodel/nist-nvd",
