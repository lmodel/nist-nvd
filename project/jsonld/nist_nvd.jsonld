    },
    {
      "name": "nvdAffectedProduct__cpes",
      "description": "The product's CPE names, in the 2.2 or the 2.3 form.",
      "comments": [
        "NVD's own pattern, with its quotes written as \\x22 and \\x27, which mean the same. The Python generators cut a raw string at a quote."
      ],
      "from_schema": "https://w3id.org/lmodel/nist-nvd/nvd_cve",
      "close_mappings": [
        "https://w3id.org/lmodel/cve/cpes"
      ],
      "slot_uri": "https://w3id.org/lmodel/nist-nvd/cpes",
      "list_elements_unique": true,
      "alias": "cpes",
      "owner": "NvdAffectedProduct",
      "domain_of": [
        "NvdAffectedProduct"
      ],
      "range": "string",
      "multivalued": true,
      "pattern": "([c][pP][eE]:/[AHOaho]?(:[A-Za-z0-9._\\-~%]*){0,6})|(cpe:2\\.3:[aho*\\-](:(((\\?*|\\*?)([a-zA-Z0-9\\-._]|(\\\\[\\\\*?!\\x22#$%&\\x27()+,/:;<=>@\\[\\]\\^`{|}~]))+(\\?*|\\*?))|[*\\-])){5}(:(([a-zA-Z]{2,3}(-([a-zA-Z]{2}|[0-9]{3}))?)|[*\\-]))(:(((\\?*|\\*?)([a-zA-Z0-9\\-._]|(\\\\[\\\\*?!\\x22#$%&\\x27()+,/:;<=>@\\[\\]\\^`{|}~]))+(\\?*|\\*?))|[*\\-])){4})",
      "@type": "SlotDefinition"
    },
    {
      "name": "nvdAffectedProduct__modules",
