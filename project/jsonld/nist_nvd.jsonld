          ],
          "slot_uri": "nist_nvd:baseSeverity",
          "range": "NvdCvssV2Severity",
          "@type": "SlotDefinition"
        },
        {
          "name": "acInsufInfo",
          "description": "Whether NVD lacked the information to rate the access complexity.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "obtainAllPrivilege",
          "description": "Whether exploiting this gains every privilege.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "obtainUserPrivilege",
          "description": "Whether exploiting this gains a user's privileges.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "obtainOtherPrivilege",
          "description": "Whether exploiting this gains some other privilege.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "userInteractionRequired",
          "description": "Whether exploiting this needs a user to act.",
          "range": "boolean",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/nist-nvd/NvdCvssMetricV2",
      "@type": "ClassDefinition"
    },
