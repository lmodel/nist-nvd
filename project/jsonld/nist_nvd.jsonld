    {
      "name": "CvssV31_version",
      "definition_uri": "https://w3id.org/lmodel/cve/version",
      "annotations": {
        "upstream_path": {
          "tag": "upstream_path",
          "value": "imports/cvss/cvss-v2.0.json#/properties/version imports/cvss/cvss-v3.0.json#/properties/version imports/cvss/cvss-v3.1.json#/properties/version imports/cvss/cvss-v4.0.json#/properties/version",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "A version string. On a score it is the CVSS version; on a product entry, the product's.",
      "comments": [
        "Each class that uses it narrows it. A top-level slot, so that lokf adapt renames it beside LOKF's version."
      ],
      "from_schema": "https://w3id.org/lmodel/cve/cve_cvss",
      "mappings": [
        "https://w3id.org/lmodel/cve/version"
      ],
      "is_a": "version",
      "domain": "CvssV31",
      "slot_uri": "https://w3id.org/lmodel/cve/version",
      "alias": "version",
      "owner": "CvssV31",
      "domain_of": [
        "CvssV31"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "version",
      "range": "string",
      "required": true,
      "equals_string": "3.1",
      "@type": "SlotDefinition"
    },
    {
      "name": "CvssV31_vectorString",
