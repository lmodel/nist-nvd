    {
      "name": "NvdAffectedVersion_version",
      "definition_uri": "https://w3id.org/lmodel/cve/version",
      "annotations": {
        "upstream_path": {
          "tag": "upstream_path",
          "value": "imports/cvss/cvss-v2.0.json#/properties/version imports/cvss/cvss-v3.0.json#/properties/version imports/cvss/cvss-v3.1.json#/properties/version imports/cvss/cvss-v4.0.json#/properties/version",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The version, or the start of the range.",
      "comments": [
        "Each class that uses it narrows it. A top-level slot, so that lokf adapt renames it beside LOKF's version."
      ],
