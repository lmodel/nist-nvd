          <cisaActionDue> @linkml:Date ? ;
          <cisaRequiredAction> @linkml:String ? ;
          <cisaVulnerabilityName> @linkml:String ? ;
          <cveTags> @<NvdCveTag> * ;
          <descriptions> @<NvdLangString> + ;
          <metrics> @<NvdMetrics> ? ;
          <affected> @<NvdAffected> * ;
          <weaknesses> @<NvdWeakness> * ;
          <configurations> @<NvdConfiguration> * ;
          <vendorComments> @<NvdVendorComment> *
       ) ;
       rdf:type [ <NvdCve> ]
    )
}

