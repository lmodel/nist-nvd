             <https://w3id.org/lmodel/nist-nvd/NvdCpeReferenceType#Vendor>
             <https://w3id.org/lmodel/nist-nvd/NvdCpeReferenceType#Version> ] ? ;
          <ref> @linkml:String
       ) ;
       rdf:type [ <NvdCpeReference> ] ?
    )
}

<NvdCpeResponse> CLOSED {
    (  $<NvdCpeResponse_tes> (  &<NvdResponseMixin_tes> ;
