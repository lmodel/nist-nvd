          <products> @<NvdCpeItem> + ;
          <format> @linkml:String ;
          <timestamp> @<NvdTimestamp> ;
          <resultsPerPage> @linkml:Integer ;
          <startIndex> @linkml:Integer ;
          <totalResults> @linkml:Integer ;
          <responseVersion> @linkml:String
       ) ;
       rdf:type [ <NvdCpeResponse> ] ?
    )
}

<NvdCpeTitle> CLOSED {
    (  $<NvdCpeTitle_tes> (  <title> @linkml:String ;
          <lang> @linkml:String
       ) ;
       rdf:type [ <NvdCpeTitle> ] ?
    )
}

<NvdCve> CLOSED {
    (  $<NvdCve_tes> (  <sourceIdentifier> @linkml:String ? ;
          <lastModified> @<NvdTimestamp> ;
          <references> @<NvdReference> + ;
          <vulnStatus> [ <https://w3id.org/lmodel/nist-nvd/NvdVulnStatus#Analyzed>
             <https://w3id.org/lmodel/nist-nvd/NvdVulnStatus#Deferred>
             <https://w3id.org/lmodel/nist-nvd/NvdVulnStatus#Awaiting%20Analysis>
