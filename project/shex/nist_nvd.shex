             <https://w3id.org/lmodel/cve/CvssV3ModifiedScope#NOT_DEFINED> ] ? ;
          cve:modifiedConfidentialityImpact [ <https://w3id.org/lmodel/cve/CvssModifiedImpact#NONE>
             <https://w3id.org/lmodel/cve/CvssModifiedImpact#LOW> <https://w3id.org/lmodel/cve/CvssModifiedImpact#HIGH>
             <https://w3id.org/lmodel/cve/CvssModifiedImpact#NOT_DEFINED> ] ? ;
          cve:modifiedIntegrityImpact [ <https://w3id.org/lmodel/cve/CvssModifiedImpact#NONE>
             <https://w3id.org/lmodel/cve/CvssModifiedImpact#LOW> <https://w3id.org/lmodel/cve/CvssModifiedImpact#HIGH>
             <https://w3id.org/lmodel/cve/CvssModifiedImpact#NOT_DEFINED> ] ? ;
          cve:modifiedAvailabilityImpact [ <https://w3id.org/lmodel/cve/CvssModifiedImpact#NONE>
             <https://w3id.org/lmodel/cve/CvssModifiedImpact#LOW> <https://w3id.org/lmodel/cve/CvssModifiedImpact#HIGH>
             <https://w3id.org/lmodel/cve/CvssModifiedImpact#NOT_DEFINED> ] ? ;
          cve:environmentalScore @linkml:Float ? ;
          cve:environmentalSeverity [ <https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/none>
             <https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/low>
             <https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/medium>
             <https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/high>
             <https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/critical> ] ? ;
          cve:baseScore @linkml:Float ;
          cve:baseSeverity [ <https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/none>
             <https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/low>
             <https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/medium>
             <https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/high>
             <https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/critical> ]
       ) ;
       rdf:type [ cve:CvssV31 ] ?
    )
}

