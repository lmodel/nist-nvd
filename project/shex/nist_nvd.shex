<NvdCveTag> CLOSED {
    (  $<NvdCveTag_tes> (  <sourceIdentifier> @linkml:String ? ;
          <tags> [ <https://w3id.org/lmodel/nist-nvd/NvdCveTagName#unsupported-when-assigned>
             <https://w3id.org/lmodel/nist-nvd/NvdCveTagName#exclusively-hosted-service>
             <https://w3id.org/lmodel/nist-nvd/NvdCveTagName#disputed> ] *
       ) ;
       rdf:type [ <NvdCveTag> ] ?
    )
}

<NvdCvssMetricV2> CLOSED {
    (  $<NvdCvssMetricV2_tes> (  <source> @linkml:String ;
          <type> [ <https://w3id.org/lmodel/nist-nvd/NvdSourceType#Primary>
             <https://w3id.org/lmodel/nist-nvd/NvdSourceType#Secondary> ] ;
          <cvssData> @cve:CvssV20 ;
          <exploitabilityScore> @linkml:Float ? ;
          <impactScore> @linkml:Float ? ;
          <baseSeverity> [ <https://w3id.org/lmodel/nist-nvd/NvdCvssV2Severity#LOW>
             <https://w3id.org/lmodel/nist-nvd/NvdCvssV2Severity#MEDIUM> <https://w3id.org/lmodel/nist-nvd/NvdCvssV2Severity#HIGH>
             ] ? ;
          <acInsufInfo> @linkml:Boolean ? ;
          <obtainAllPrivilege> @linkml:Boolean ? ;
          <obtainUserPrivilege> @linkml:Boolean ? ;
          <obtainOtherPrivilege> @linkml:Boolean ? ;
          <userInteractionRequired> @linkml:Boolean ?
       ) ;
       rdf:type [ <NvdCvssMetricV2> ] ?
    )
}

<NvdCvssMetricV30> CLOSED {
    (  $<NvdCvssMetricV30_tes> (  <source> @linkml:String ;
          <type> [ <https://w3id.org/lmodel/nist-nvd/NvdSourceType#Primary>
             <https://w3id.org/lmodel/nist-nvd/NvdSourceType#Secondary> ] ;
          <cvssData> @cve:CvssV30 ;
          <exploitabilityScore> @linkml:Float ? ;
          <impactScore> @linkml:Float ?
       ) ;
       rdf:type [ <NvdCvssMetricV30> ] ?
    )
}

<NvdCvssMetricV31> CLOSED {
    (  $<NvdCvssMetricV31_tes> (  <source> @linkml:String ;
          <type> [ <https://w3id.org/lmodel/nist-nvd/NvdSourceType#Primary>
             <https://w3id.org/lmodel/nist-nvd/NvdSourceType#Secondary> ] ;
          <cvssData> @cve:CvssV31 ;
          <exploitabilityScore> @linkml:Float ? ;
          <impactScore> @linkml:Float ?
       ) ;
       rdf:type [ <NvdCvssMetricV31> ] ?
    )
}

<NvdCvssMetricV40> CLOSED {
    (  $<NvdCvssMetricV40_tes> (  <source> @linkml:String ;
          <type> [ <https://w3id.org/lmodel/nist-nvd/NvdSourceType#Primary>
             <https://w3id.org/lmodel/nist-nvd/NvdSourceType#Secondary> ] ;
          <cvssData> @cve:CvssV40
       ) ;
       rdf:type [ <NvdCvssMetricV40> ] ?
    )
}

<NvdHistoryResponse> CLOSED {
    (  $<NvdHistoryResponse_tes> (  &<NvdResponseMixin_tes> ;
          rdf:type [ <NvdResponseMixin> ] ? ;
          <cveChanges> @<NvdChangeItem> * ;
          <format> @linkml:String ;
          <timestamp> @<NvdTimestamp> ;
          <resultsPerPage> @linkml:Integer ;
          <startIndex> @linkml:Integer ;
          <totalResults> @linkml:Integer ;
          <responseVersion> @linkml:String
       ) ;
       rdf:type [ <NvdHistoryResponse> ] ?
    )
}

<NvdLangString> CLOSED {
    (  $<NvdLangString_tes> (  <lang> @linkml:String ;
          <langStringValue> @linkml:String
       ) ;
       rdf:type [ <NvdLangString> ] ?
    )
}

<NvdMatchedCpe> CLOSED {
    (  $<NvdMatchedCpe_tes> (  <cpeName> @linkml:String ;
          <cpeNameId> @<NvdUuid>
       ) ;
       rdf:type [ <NvdMatchedCpe> ] ?
    )
}

<NvdMatchString> CLOSED {
    (  $<NvdMatchString_tes> (  <criteria> @linkml:String ;
          <versionStartExcluding> @linkml:String ? ;
          <versionStartIncluding> @linkml:String ? ;
          <versionEndExcluding> @linkml:String ? ;
          <versionEndIncluding> @linkml:String ? ;
          <created> @<NvdTimestamp> ;
          <lastModified> @<NvdTimestamp> ;
          <status> [ <https://w3id.org/lmodel/nist-nvd/NvdMatchStringStatus#Active>
             <https://w3id.org/lmodel/nist-nvd/NvdMatchStringStatus#Inactive> ] ;
          <cpeLastModified> @<NvdTimestamp> ? ;
          <matches> @<NvdMatchedCpe> *
       ) ;
       rdf:type [ <NvdMatchString> ]
    )
}

<NvdMatchStringItem> CLOSED {
    (  $<NvdMatchStringItem_tes> <matchString> @<NvdMatchString> ;
       rdf:type [ <NvdMatchStringItem> ] ?
    )
}

<NvdMetrics> CLOSED {
    (  $<NvdMetrics_tes> (  <cvssMetricV40> @<NvdCvssMetricV40> * ;
          <cvssMetricV31> @<NvdCvssMetricV31> * ;
          <cvssMetricV30> @<NvdCvssMetricV30> * ;
          <cvssMetricV2> @<NvdCvssMetricV2> * ;
          <ssvcV203> @<NvdSsvcMetricV203> *
       ) ;
       rdf:type [ <NvdMetrics> ] ?
    )
}

<NvdProgramRoutine> CLOSED {
    (  $<NvdProgramRoutine_tes> <name> @linkml:String ;
       rdf:type [ <NvdProgramRoutine> ] ?
    )
}

<NvdReference> CLOSED {
    (  $<NvdReference_tes> (  <url> @linkml:Uri ;
          <source> @linkml:String ? ;
          <tags> [ <https://w3id.org/lmodel/nist-nvd/NvdReferenceTag#Broken%20Link>
             <https://w3id.org/lmodel/nist-nvd/NvdReferenceTag#Exploit>
             <https://w3id.org/lmodel/nist-nvd/NvdReferenceTag#Issue%20Tracking>
             <https://w3id.org/lmodel/nist-nvd/NvdReferenceTag#Mailing%20List>
             <https://w3id.org/lmodel/nist-nvd/NvdReferenceTag#Mitigation>
             <https://w3id.org/lmodel/nist-nvd/NvdReferenceTag#Not%20Applicable>
             <https://w3id.org/lmodel/nist-nvd/NvdReferenceTag#Patch>
             <https://w3id.org/lmodel/nist-nvd/NvdReferenceTag#Permissions%20Required>
             <https://w3id.org/lmodel/nist-nvd/NvdReferenceTag#Press/Media%20Coverage>
             <https://w3id.org/lmodel/nist-nvd/NvdReferenceTag#Related> <https://w3id.org/lmodel/nist-nvd/NvdReferenceTag#Product>
             <https://w3id.org/lmodel/nist-nvd/NvdReferenceTag#Release%20Notes>
             <https://w3id.org/lmodel/nist-nvd/NvdReferenceTag#Technical%20Description>
             <https://w3id.org/lmodel/nist-nvd/NvdReferenceTag#Third%20Party%20Advisory>
             <https://w3id.org/lmodel/nist-nvd/NvdReferenceTag#Tool%20Signature>
             <https://w3id.org/lmodel/nist-nvd/NvdReferenceTag#URL%20Repurposed>
             <https://w3id.org/lmodel/nist-nvd/NvdReferenceTag#US%20Government%20Resource>
             <https://w3id.org/lmodel/nist-nvd/NvdReferenceTag#VDB%20Entry>
             <https://w3id.org/lmodel/nist-nvd/NvdReferenceTag#Vendor%20Advisory> ] *
       ) ;
       rdf:type [ <NvdReference> ] ?
    )
}

<NvdResponseMixin> {
    (  $<NvdResponseMixin_tes> (  <format> @linkml:String ;
          <timestamp> @<NvdTimestamp> ;
          <resultsPerPage> @linkml:Integer ;
          <startIndex> @linkml:Integer ;
          <totalResults> @linkml:Integer ;
          <responseVersion> @linkml:String
       ) ;
       rdf:type [ <NvdResponseMixin> ] ?
    )
}

<NvdSsvcData> CLOSED {
    (  $<NvdSsvcData_tes> (  <timestamp> @<NvdTimestamp> ? ;
          <computed> @linkml:String ? ;
          <options> @<NvdSsvcOption> + ;
          <role> @linkml:String ;
          <ssvcVersion> @linkml:String ;
          <decisionTree> @<NvdSsvcDecisionTree> ? ;
          <ssvcSubject> @linkml:String ? ;
          <decisionTreeUrl> @linkml:Uri ? ;
          <generator> @linkml:String ?
       ) ;
       rdf:type [ <NvdSsvcData> ] ?
    )
}

<NvdSsvcDecisionTree> CLOSED {
    (  $<NvdSsvcDecisionTree_tes> rdf:type . * ;
       rdf:type [ linkml:Any ] ?
    )
}

<NvdSsvcMetricV203> CLOSED {
    (  $<NvdSsvcMetricV203_tes> (  <source> @linkml:String ;
          <ssvcData> @<NvdSsvcData>
       ) ;
       rdf:type [ <NvdSsvcMetricV203> ] ?
    )
}

<NvdSsvcOption> CLOSED {
    (  $<NvdSsvcOption_tes> (  <exploitation> @linkml:String ? ;
          <automatable> @linkml:String ? ;
          <technicalImpact> @linkml:String ?
       ) ;
       rdf:type [ <NvdSsvcOption> ] ?
    )
}

<NvdVendorComment> CLOSED {
    (  $<NvdVendorComment_tes> (  <lastModified> @<NvdTimestamp> ;
          <organization> @linkml:String ;
          <comment> @linkml:String
       ) ;
       rdf:type [ <NvdVendorComment> ] ?
    )
}

<NvdVersionChange> CLOSED {
    (  $<NvdVersionChange_tes> (  <at> @linkml:String ;
          <status> [ <https://w3id.org/lmodel/nist-nvd/NvdVersionStatus#affected>
             <https://w3id.org/lmodel/nist-nvd/NvdVersionStatus#unaffected>
             <https://w3id.org/lmodel/nist-nvd/NvdVersionStatus#unknown> ]
       ) ;
       rdf:type [ <NvdVersionChange> ] ?
    )
}

<NvdVulnerability> CLOSED {
    (  $<NvdVulnerability_tes> <cve> @<NvdCve> ;
       rdf:type [ <NvdVulnerability> ] ?
    )
}

<NvdWeakness> CLOSED {
    (  $<NvdWeakness_tes> (  <source> @linkml:String ;
          <type> [ <https://w3id.org/lmodel/nist-nvd/NvdSourceType#Primary>
             <https://w3id.org/lmodel/nist-nvd/NvdSourceType#Secondary> ] ;
          <description> @<NvdLangString> +
       ) ;
       rdf:type [ <NvdWeakness> ] ?
    )
}
