          <timestamp> @<NvdTimestamp> ;
          <resultsPerPage> @linkml:Integer ;
          <startIndex> @linkml:Integer ;
          <totalResults> @linkml:Integer ;
          <responseVersion> @linkml:String
       ) ;
       rdf:type [ <NvdCpeMatchResponse> ] ?
    )
}

<NvdCpeNameLink> CLOSED {
    (  $<NvdCpeNameLink_tes> (  <cpeName> @linkml:String ? ;
          <cpeNameId> @<NvdUuid> ?
       ) ;
