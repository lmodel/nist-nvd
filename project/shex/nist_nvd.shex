<NvdAffected> CLOSED {
    (  $<NvdAffected_tes> (  <source> @linkml:String ;
          <affectedData> @<NvdAffectedProduct> +
       ) ;
       rdf:type [ <NvdAffected> ] ?
    )
}

<NvdAffectedProduct> CLOSED {
    (  $<NvdAffectedProduct_tes> (  <defaultStatus> [ <https://w3id.org/lmodel/nist-nvd/NvdVersionStatus#affected>
             <https://w3id.org/lmodel/nist-nvd/NvdVersionStatus#unaffected>
             <https://w3id.org/lmodel/nist-nvd/NvdVersionStatus#unknown> ] ? ;
          <vendor> @linkml:String ? ;
          <product> @linkml:String ? ;
          <collectionURL> @linkml:Uri ? ;
          <packageName> @linkml:String ? ;
          <cpes> @linkml:String * ;
          <modules> @linkml:String * ;
          <programFiles> @linkml:String * ;
          <programRoutines> @<NvdProgramRoutine> * ;
          <platforms> @linkml:String * ;
          <repo> @linkml:String ? ;
          <versions> @<NvdAffectedVersion> * ;
          <packageURL> @linkml:Uri ?
       ) ;
       rdf:type [ <NvdAffectedProduct> ] ?
    )
}

<NvdAffectedVersion> CLOSED {
    (  $<NvdAffectedVersion_tes> (  cve:version @linkml:String ;
          <status> [ <https://w3id.org/lmodel/nist-nvd/NvdVersionStatus#affected>
             <https://w3id.org/lmodel/nist-nvd/NvdVersionStatus#unaffected>
             <https://w3id.org/lmodel/nist-nvd/NvdVersionStatus#unknown> ] ;
          <versionType> @linkml:String ? ;
          <lessThan> @linkml:String ? ;
          <lessThanOrEqual> @linkml:String ? ;
          <changes> @<NvdVersionChange> *
       ) ;
       rdf:type [ <NvdAffectedVersion> ] ?
    )
}

<NvdChange> CLOSED {
    (  $<NvdChange_tes> (  <sourceIdentifier> @linkml:String ;
          <created> @<NvdTimestamp> ? ;
          <cveId> @<NvdCve> ;
          <eventName> @linkml:String ;
          <details> @<NvdChangeDetail> *
       ) ;
       rdf:type [ <NvdChange> ]
    )
}

<NvdChangeDetail> CLOSED {
    (  $<NvdChangeDetail_tes> (  <type> @linkml:String ;
          <action> @linkml:String ? ;
          <oldValue> @linkml:String ? ;
          <newValue> @linkml:String ?
       ) ;
       rdf:type [ <NvdChangeDetail> ] ?
    )
}

<NvdChangeItem> CLOSED {
    (  $<NvdChangeItem_tes> <change> @<NvdChange> ;
       rdf:type [ <NvdChangeItem> ] ?
    )
}

<NvdChangeObject> CLOSED {
    (  $<NvdChangeObject_tes> rdf:type . * ;
       rdf:type [ <NvdChangeObject> ] ?
    )
}

<NvdConfiguration> CLOSED {
    (  $<NvdConfiguration_tes> (  <operator> [ <https://w3id.org/lmodel/nist-nvd/NvdOperator#AND>
             <https://w3id.org/lmodel/nist-nvd/NvdOperator#OR> ] ? ;
          <negate> @linkml:Boolean ? ;
          <nodes> @<NvdConfigurationNode> +
       ) ;
       rdf:type [ <NvdConfiguration> ] ?
    )
}

<NvdConfigurationNode> CLOSED {
    (  $<NvdConfigurationNode_tes> (  <operator> [ <https://w3id.org/lmodel/nist-nvd/NvdOperator#AND>
             <https://w3id.org/lmodel/nist-nvd/NvdOperator#OR> ] ;
          <negate> @linkml:Boolean ? ;
          <cpeMatch> @<NvdCpeMatch> +
       ) ;
       rdf:type [ <NvdConfigurationNode> ] ?
    )
}

<NvdCpe> CLOSED {
    (  $<NvdCpe_tes> (  <cpeName> @linkml:String ;
          <created> @<NvdTimestamp> ;
          <lastModified> @<NvdTimestamp> ;
          <deprecated> @linkml:Boolean ;
          <titles> @<NvdCpeTitle> * ;
          <refs> @<NvdCpeReference> * ;
          <deprecatedBy> @<NvdCpeNameLink> * ;
          <deprecates> @<NvdCpeNameLink> *
       ) ;
       rdf:type [ <NvdCpe> ]
    )
}

<NvdCpeItem> CLOSED {
    (  $<NvdCpeItem_tes> <cpe> @<NvdCpe> ;
       rdf:type [ <NvdCpeItem> ] ?
    )
}

<NvdCpeMatch> CLOSED {
    (  $<NvdCpeMatch_tes> (  <criteria> @linkml:String ;
          <matchCriteriaId> @<NvdUuid> ;
          <versionStartExcluding> @linkml:String ? ;
          <versionStartIncluding> @linkml:String ? ;
          <versionEndExcluding> @linkml:String ? ;
          <versionEndIncluding> @linkml:String ? ;
          <vulnerable> @linkml:Boolean
       ) ;
       rdf:type [ <NvdCpeMatch> ] ?
    )
}

<NvdCpeMatchResponse> CLOSED {
