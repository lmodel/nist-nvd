             <https://w3id.org/lmodel/nist-nvd/NvdVulnStatus#Undergoing%20Analysis>
             <https://w3id.org/lmodel/nist-nvd/NvdVulnStatus#Rejected> ] ? ;
          <published> @<NvdTimestamp> ;
          <evaluatorComment> @linkml:String ? ;
          <evaluatorSolution> @linkml:String ? ;
          <evaluatorImpact> @linkml:String ? ;
