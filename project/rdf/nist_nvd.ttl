	linkml:annotations _:c14n297 ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/availabilityImpact"^^xsd:anyURI ;
	linkml:description "How much an attack could disrupt the service." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-nvd/CvssV20> , <https://w3id.org/lmodel/nist-nvd/CvssV30> , <https://w3id.org/lmodel/nist-nvd/CvssV31> ;
	linkml:owner <https://w3id.org/lmodel/nist-nvd/CvssV31> ;
	linkml:range <https://w3id.org/lmodel/nist-nvd/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/cve/availabilityImpact"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-nvd/availabilityRequirement> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/cve/cve_cvss"^^xsd:anyURI ;
	linkml:annotations _:c14n112 ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/availabilityRequirement"^^xsd:anyURI ;
	linkml:description "How much availability matters to the scorer for the affected system." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-nvd/CvssV20> , <https://w3id.org/lmodel/nist-nvd/CvssV30> , <https://w3id.org/lmodel/nist-nvd/CvssV31> , <https://w3id.org/lmodel/nist-nvd/CvssV40> ;
	linkml:owner <https://w3id.org/lmodel/nist-nvd/CvssV40> ;
	linkml:range <https://w3id.org/lmodel/nist-nvd/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/cve/availabilityRequirement"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-nvd/baseScore> a linkml:SlotDefinition ;
	skos:closeMatch "http://w3id.org/sepses/vocab/ref/cvss#baseScore"^^xsd:anyURI , "https://spdx.org/rdf/3.0.1/terms/Security/score"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/cve/cve_cvss"^^xsd:anyURI ;
	linkml:annotations _:c14n260 ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/baseScore"^^xsd:anyURI ;
	linkml:description "The score from 0 to 10 for what is inherent in the flaw." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-nvd/CvssSeverityBandsMixin> , <https://w3id.org/lmodel/nist-nvd/CvssV20> ;
	linkml:maximum_value "0"^^linkml:\@id , "10"^^linkml:\@id , "10.0"^^linkml:\@id , "3.9"^^linkml:\@id , "6.9"^^linkml:\@id , "8.9"^^linkml:\@id ;
	linkml:minimum_value "0"^^linkml:\@id , "0.1"^^linkml:\@id , "4.0"^^linkml:\@id , "7.0"^^linkml:\@id , "9.0"^^linkml:\@id ;
	linkml:owner <https://w3id.org/lmodel/nist-nvd/CvssV20> ;
	linkml:range <https://w3id.org/lmodel/nist-nvd/float> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/cve/baseScore"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-nvd/baseSeverity> a linkml:SlotDefinition ;
	skos:closeMatch "http://w3id.org/sepses/vocab/ref/cvss#baseSeverity"^^xsd:anyURI , "https://spdx.org/rdf/3.0.1/terms/Security/severity"^^xsd:anyURI , "sepses_cvss:severity"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/cve/cve_cvss"^^xsd:anyURI ;
	linkml:annotations _:c14n23 ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/baseSeverity"^^xsd:anyURI ;
	linkml:description "The rating in words that the base score falls under." , "The severity band of the base score, which CVSS 2.0 leaves to NVD." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-nvd/CvssSeverityBandsMixin> ;
	linkml:equals_string "CRITICAL" , "HIGH" , "LOW" , "MEDIUM" , "NONE" ;
	linkml:owner <https://w3id.org/lmodel/nist-nvd/CvssSeverityBandsMixin> ;
	linkml:range <https://w3id.org/lmodel/nist-nvd/CvssSeverity> , <https://w3id.org/lmodel/nist-nvd/NvdCvssV2Severity> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/cve/baseSeverity"^^xsd:anyURI , "nist_nvd:baseSeverity"^^xsd:anyURI .
