	linkml:range <https://w3id.org/lmodel/nist-nvd/CvssV2Authentication> .
<https://w3id.org/lmodel/nist-nvd/automatable> a linkml:SlotDefinition ;
	skos:editorialNote "CVSS 4.0's Automatable differs from this key only by case, so the two share one page of the generated docs on a case-insensitive filesystem. Both are real keys, so neither is renamed, and tests/test_schema_rules.py pins this as the one such pair." ;
	linkml:any_of _:c14n238 , _:c14n272 ;
	linkml:description "Whether an attacker could automate the attack, as yes or no." .
<https://w3id.org/lmodel/nist-nvd/availabilityImpact> a linkml:SlotDefinition ;
	skos:closeMatch "http://w3id.org/sepses/vocab/ref/cvss#availabilityImpact"^^xsd:anyURI ;
