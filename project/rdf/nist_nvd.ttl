<https://w3id.org/lmodel/nist-nvd/exploitMaturity> a linkml:SlotDefinition ;
	linkml:annotations _:c14n258 ;
	linkml:description "How much is known about attacks on this flaw, in CVSS 4.0's terms." ;
	linkml:ifabsent "CvssV4ExploitMaturity(NOT_DEFINED)" ;
	linkml:range <https://w3id.org/lmodel/nist-nvd/CvssV4ExploitMaturity> .
<https://w3id.org/lmodel/nist-nvd/exploitability> a linkml:SlotDefinition ;
	linkml:annotations _:c14n69 ;
	linkml:description "How far working attack code has come, in CVSS 2.0's terms." ;
	linkml:range <https://w3id.org/lmodel/nist-nvd/CvssExploitCodeMaturity> .
