	linkml:slot_uri "https://w3id.org/lmodel/nist-nvd/description"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-nvd/descriptions> a linkml:SlotDefinition ;
	skos:closeMatch "cve:descriptions"^^xsd:anyURI ;
	linkml:description "What the vulnerability is, in one or more languages." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:minimum_cardinality 1 ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/nist-nvd/NvdLangString> ;
	linkml:required true .
<https://w3id.org/lmodel/nist-nvd/details> a linkml:SlotDefinition ;
