	linkml:owner <https://w3id.org/lmodel/nist-nvd/NvdChange> ;
	linkml:range <https://w3id.org/lmodel/nist-nvd/nvd_timestamp> ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-nvd/created"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-nvd/criteria> a linkml:SlotDefinition ;
