	linkml:maximum_value "10"^^linkml:\@id ;
	linkml:minimum_value "0"^^linkml:\@id ;
	linkml:owner <https://w3id.org/lmodel/nist-nvd/NvdCvssMetricV31> ;
	linkml:range <https://w3id.org/lmodel/nist-nvd/float> ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-nvd/exploitabilityScore"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-nvd/exploitation> a linkml:SlotDefinition ;
	linkml:any_of _:c14n30 , _:c14n66 ;
