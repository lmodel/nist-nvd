<https://w3id.org/lmodel/nist-nvd/nvd_cve_identifier> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-nvd/nvd_core"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-nvd/NvdCveIdentifier"^^xsd:anyURI ;
	linkml:description "A CVE identifier, such as CVE-2021-44228." ;
	linkml:pattern "^CVE-[0-9]{4}-[0-9]{4,}$" ;
	linkml:typeof <https://w3id.org/lmodel/nist-nvd/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-nvd/nvd_timestamp> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-nvd/nvd_core"^^xsd:anyURI ;
	skos:note "NVD's schemas say format date-time, which is RFC 3339 and needs a UTC offset. NVD's records and responses write none, so a validator that checks the format refuses every real record. This type admits both forms, and tests/test_upstream.py lists the departure." ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-nvd/NvdTimestamp"^^xsd:anyURI ;
	linkml:description "A date and time as NVD writes it: ISO 8601, with fractional seconds and a UTC offset where the writer gives them." ;
	linkml:pattern "^[0-9]{4}-(0[1-9]|1[012])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})?$" ;
	linkml:typeof <https://w3id.org/lmodel/nist-nvd/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#dateTime"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-nvd/nvd_uuid> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-nvd/nvd_core"^^xsd:anyURI ;
	skos:note "NVD's schemas say format uuid, and LinkML has no such type. NVD writes these in capitals." ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-nvd/NvdUuid"^^xsd:anyURI ;
	linkml:description "A UUID in its usual hexadecimal form with four hyphens." ;
	linkml:pattern "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" ;
	linkml:typeof <https://w3id.org/lmodel/nist-nvd/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-nvd/objectidentifier> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"objectidentifier\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	skos:note "Used for inheritance and type checking" ;
	linkml:base "ElementIdentifier" ;
	linkml:definition_uri "https://w3id.org/linkml/Objectidentifier"^^xsd:anyURI ;
	linkml:description "A URI or CURIE that represents an object in the model." ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/ns/shex#iri"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-nvd/obtainAllPrivilege> a linkml:SlotDefinition ;
	linkml:description "Whether exploiting this gains every privilege." ;
	linkml:range <https://w3id.org/lmodel/nist-nvd/boolean> .
<https://w3id.org/lmodel/nist-nvd/obtainOtherPrivilege> a linkml:SlotDefinition ;
	linkml:description "Whether exploiting this gains some other privilege." ;
	linkml:range <https://w3id.org/lmodel/nist-nvd/boolean> .
<https://w3id.org/lmodel/nist-nvd/obtainUserPrivilege> a linkml:SlotDefinition ;
	linkml:description "Whether exploiting this gains a user's privileges." ;
	linkml:range <https://w3id.org/lmodel/nist-nvd/boolean> .
<https://w3id.org/lmodel/nist-nvd/oldValue> a linkml:SlotDefinition ;
	linkml:any_of _:c14n16 , _:c14n161 , _:c14n199 ;
	linkml:description "The value before the change." .
<https://w3id.org/lmodel/nist-nvd/operator> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-nvd/nvd_cve"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/nist-nvd/operator"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-nvd/operator"^^xsd:anyURI ;
	linkml:description "How the parts of this configuration combine." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-nvd/NvdConfiguration> , <https://w3id.org/lmodel/nist-nvd/NvdConfigurationNode> ;
	linkml:owner <https://w3id.org/lmodel/nist-nvd/NvdConfigurationNode> ;
	linkml:range <https://w3id.org/lmodel/nist-nvd/NvdOperator> ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-nvd/operator"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-nvd/options> a linkml:SlotDefinition ;
	linkml:description "The answers given, each as a decision point and its value." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:list_elements_unique true ;
	linkml:minimum_cardinality 1 ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/nist-nvd/NvdSsvcOption> ;
	linkml:required true .
<https://w3id.org/lmodel/nist-nvd/organization> a linkml:SlotDefinition ;
	linkml:description "The vendor's name." ;
	linkml:required true .
<https://w3id.org/lmodel/nist-nvd/packageName> a linkml:SlotDefinition ;
	skos:closeMatch "cve:packageName"^^xsd:anyURI ;
	linkml:description "The package's name within that collection." ;
	linkml:pattern "^[\\s\\S]{1,2048}$" .
<https://w3id.org/lmodel/nist-nvd/packageURL> a linkml:SlotDefinition ;
	skos:closeMatch "cve:packageURL"^^xsd:anyURI ;
	linkml:description "The product's Package URL, with no version in it." ;
	linkml:pattern "^[\\s\\S]{1,2048}$" ;
	linkml:range <https://w3id.org/lmodel/nist-nvd/uri> .
<https://w3id.org/lmodel/nist-nvd/platforms> a linkml:SlotDefinition ;
	skos:closeMatch "cve:platforms"^^xsd:anyURI ;
	linkml:description "The platforms the vulnerability is limited to." ;
	linkml:list_elements_unique true ;
	linkml:minimum_cardinality 1 ;
	linkml:multivalued true ;
	linkml:pattern "^[\\s\\S]{0,1024}$" .
<https://w3id.org/lmodel/nist-nvd/privilegesRequired> a linkml:SlotDefinition ;
	skos:closeMatch "http://w3id.org/sepses/vocab/ref/cvss#privilegesRequired"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/cve/cve_cvss"^^xsd:anyURI ;
	linkml:annotations _:c14n188 ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/privilegesRequired"^^xsd:anyURI ;
	linkml:description "What level of access an attacker needs before using the flaw." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-nvd/CvssV30> , <https://w3id.org/lmodel/nist-nvd/CvssV31> , <https://w3id.org/lmodel/nist-nvd/CvssV40> ;
	linkml:owner <https://w3id.org/lmodel/nist-nvd/CvssV40> ;
	linkml:range <https://w3id.org/lmodel/nist-nvd/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/cve/privilegesRequired"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-nvd/product> a linkml:SlotDefinition ;
	skos:closeMatch "cve:product"^^xsd:anyURI ;
	linkml:description "The product's name." ;
	linkml:pattern "^[\\s\\S]{1,2048}$" .
<https://w3id.org/lmodel/nist-nvd/products> a linkml:SlotDefinition ;
	linkml:description "The products on this page." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/nist-nvd/NvdCpeItem> ;
	linkml:required true .
<https://w3id.org/lmodel/nist-nvd/programFiles> a linkml:SlotDefinition ;
	skos:closeMatch "cve:programFiles"^^xsd:anyURI ;
	linkml:description "The affected source code files." ;
	linkml:list_elements_unique true ;
	linkml:multivalued true ;
	linkml:pattern "^[\\s\\S]{1,1024}$" .
<https://w3id.org/lmodel/nist-nvd/programRoutines> a linkml:SlotDefinition ;
	skos:closeMatch "cve:programRoutines"^^xsd:anyURI ;
	linkml:description "The affected source code routines." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:list_elements_unique true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/nist-nvd/NvdProgramRoutine> .
<https://w3id.org/lmodel/nist-nvd/providerUrgency> a linkml:SlotDefinition ;
	linkml:annotations _:c14n232 ;
	linkml:description "How urgent the product's supplier says the flaw is, as a colour." ;
	linkml:ifabsent "CvssV4ProviderUrgency(NOT_DEFINED)" ;
	linkml:range <https://w3id.org/lmodel/nist-nvd/CvssV4ProviderUrgency> .
<https://w3id.org/lmodel/nist-nvd/published> a linkml:SlotDefinition ;
	skos:closeMatch "dcterms:issued"^^xsd:anyURI , "schema:datePublished"^^xsd:anyURI , "spdx3:Security/publishedTime"^^xsd:anyURI ;
	skos:note "This is NVD's own time, not the CVE record's datePublished. For CVE-2021-44228 the CVE record says 2021-12-10T00:00:00.000Z and NVD 2021-12-10T10:15:09.143, so the mapping is only a related one." ;
	skos:relatedMatch "cve:datePublished"^^xsd:anyURI ;
	linkml:description "When NVD published this vulnerability." ;
	linkml:range <https://w3id.org/lmodel/nist-nvd/nvd_timestamp> ;
	linkml:required true .
<https://w3id.org/lmodel/nist-nvd/ref> a linkml:SlotDefinition ;
	skos:note "NVD's own pattern, with its single quote written as \\x27, which means the same. gen-python cuts a raw string at a single quote." ;
	linkml:description "The page's address." ;
	linkml:pattern "^([A-Za-z][A-Za-z0-9+.-]+):(\\/\\/([^@]+@)?([A-Za-z0-9.\\-_~]+)(:\\d+)?)?((?:[A-Za-z0-9-._~]|%[A-Fa-f0-9]|[!$&\\x27\\[\\]()*+,;=:@])+(?:\\/(?:[A-Za-z0-9-._~]|%[A-Fa-f0-9]|[!$&\\x27\\[\\]()*+,;=:@])*)*|(?:\\/(?:[A-Za-z0-9-._~]|%[A-Fa-f0-9]|[!$&\\x27()*+,;=:@])+)*)?(\\?(?:[A-Za-z0-9-._~]|%[A-Fa-f0-9]|[!$&\\x27\\[\\]()*+,;=:@]|[/?])*)?(\\#(?:[A-Za-z0-9-._~]|%[A-Fa-f0-9]|[!$&\\x27\\[\\]()*+,;=:@]|[/?])*)?$" ;
	linkml:required true .
<https://w3id.org/lmodel/nist-nvd/references> a linkml:SlotDefinition ;
	skos:closeMatch "http://w3id.org/sepses/vocab/ref/cve#hasReference"^^xsd:anyURI , "https://w3id.org/lmodel/cve/references"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/nist-nvd/nvd_cve"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/nist-nvd/references"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-nvd/references"^^xsd:anyURI ;
	linkml:description "The pages that NVD lists about this vulnerability." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-nvd/NvdCve> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/nist-nvd/NvdCve> ;
	linkml:range <https://w3id.org/lmodel/nist-nvd/NvdReference> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-nvd/references"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-nvd/refs> a linkml:SlotDefinition ;
	skos:closeMatch "dcterms:references"^^xsd:anyURI ;
	linkml:description "Pages about the product." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/nist-nvd/NvdCpeReference> .
<https://w3id.org/lmodel/nist-nvd/remediationLevel> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/cve/cve_cvss"^^xsd:anyURI ;
	linkml:annotations _:c14n7 ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/remediationLevel"^^xsd:anyURI ;
	linkml:description "What kind of fix is available." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-nvd/CvssV20> , <https://w3id.org/lmodel/nist-nvd/CvssV30> , <https://w3id.org/lmodel/nist-nvd/CvssV31> ;
	linkml:owner <https://w3id.org/lmodel/nist-nvd/CvssV31> ;
	linkml:range <https://w3id.org/lmodel/nist-nvd/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/cve/remediationLevel"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-nvd/repo> a linkml:SlotDefinition ;
	skos:closeMatch "cve:repo"^^xsd:anyURI ;
	skos:note "NVD's file says format uri. Some records write an address that RFC 3986 refuses, such as git://git@gitlab.com:gitlab-org/gitlab.git, so this is a string and tests/test_upstream.py lists the departure." ;
	linkml:description "The address of the product's source code repository." ;
	linkml:pattern "^[\\s\\S]{1,2048}$" .
<https://w3id.org/lmodel/nist-nvd/reportConfidence> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/cve/cve_cvss"^^xsd:anyURI ;
	linkml:annotations _:c14n224 ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/reportConfidence"^^xsd:anyURI ;
	linkml:description "How far the flaw's existence and details have been confirmed." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-nvd/CvssV20> , <https://w3id.org/lmodel/nist-nvd/CvssV30> , <https://w3id.org/lmodel/nist-nvd/CvssV31> ;
	linkml:owner <https://w3id.org/lmodel/nist-nvd/CvssV31> ;
	linkml:range <https://w3id.org/lmodel/nist-nvd/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/cve/reportConfidence"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-nvd/resultsPerPage> a linkml:SlotDefinition ;
	linkml:description "How many results this page holds." ;
	linkml:range <https://w3id.org/lmodel/nist-nvd/integer> ;
	linkml:required true ;
	linkml:slot_uri "nist_nvd:resultsPerPage"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-nvd/role> a linkml:SlotDefinition ;
	linkml:description "The role of whoever made the decision, such as CISA Coordinator." ;
	linkml:required true .
<https://w3id.org/lmodel/nist-nvd/scope> a linkml:SlotDefinition ;
	skos:closeMatch "http://w3id.org/sepses/vocab/ref/cvss#scope"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/cve/cve_cvss"^^xsd:anyURI ;
	linkml:annotations _:c14n82 ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/scope"^^xsd:anyURI ;
	linkml:description "Whether an attack can reach beyond the component that holds the flaw." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-nvd/CvssV30> , <https://w3id.org/lmodel/nist-nvd/CvssV31> ;
	linkml:owner <https://w3id.org/lmodel/nist-nvd/CvssV31> ;
	linkml:range <https://w3id.org/lmodel/nist-nvd/CvssV3Scope> ;
	linkml:slot_uri "https://w3id.org/lmodel/cve/scope"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-nvd/source> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-nvd/nvd_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/nist-nvd/source"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-nvd/source"^^xsd:anyURI ;
	linkml:description "The email address or UUID of the organization that supplied this." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-nvd/NvdAffected> , <https://w3id.org/lmodel/nist-nvd/NvdCvssMetricV2> , <https://w3id.org/lmodel/nist-nvd/NvdCvssMetricV30> , <https://w3id.org/lmodel/nist-nvd/NvdCvssMetricV31> , <https://w3id.org/lmodel/nist-nvd/NvdCvssMetricV40> , <https://w3id.org/lmodel/nist-nvd/NvdReference> , <https://w3id.org/lmodel/nist-nvd/NvdSsvcMetricV203> , <https://w3id.org/lmodel/nist-nvd/NvdWeakness> ;
	linkml:owner <https://w3id.org/lmodel/nist-nvd/NvdWeakness> ;
	linkml:range <https://w3id.org/lmodel/nist-nvd/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-nvd/source"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-nvd/sourceIdentifier> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-nvd/nvd_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/nist-nvd/sourceIdentifier"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-nvd/sourceIdentifier"^^xsd:anyURI ;
