	skos:mappingRelation "https://w3id.org/lmodel/nist-nvd/lang"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-nvd/lang"^^xsd:anyURI ;
	linkml:description "The language of the text beside it, as a language code." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-nvd/NvdCpeTitle> , <https://w3id.org/lmodel/nist-nvd/NvdLangString> ;
	linkml:owner <https://w3id.org/lmodel/nist-nvd/NvdCpeTitle> ;
	linkml:range <https://w3id.org/lmodel/nist-nvd/string> ;
