	linkml:description "A remark from NVD's analyst." .
<https://w3id.org/lmodel/nist-nvd/evaluatorImpact> a linkml:SlotDefinition ;
	linkml:description "What the vulnerability can lead to, from NVD's analyst." .
<https://w3id.org/lmodel/nist-nvd/evaluatorSolution> a linkml:SlotDefinition ;
	linkml:description "A way to resolve the vulnerability, from NVD's analyst." .
<https://w3id.org/lmodel/nist-nvd/eventName> a linkml:SlotDefinition ;
	skos:note "NVD's schema says only that this is a string. The samples read here hold too little of a list of 2.4 million changes to close it, so it stays a string." ;
	linkml:description "The kind of event, such as Initial Analysis or CVE Modified." ;
	linkml:required true .
<https://w3id.org/lmodel/nist-nvd/exclusively-hosted-service> linkml:description "The product exists only as a hosted service." .
<https://w3id.org/lmodel/nist-nvd/exploitCodeMaturity> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/cve/cve_cvss"^^xsd:anyURI ;
	linkml:annotations _:c14n68 ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/exploitCodeMaturity"^^xsd:anyURI ;
