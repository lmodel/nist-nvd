	linkml:slot_uri "https://w3id.org/lmodel/nist-nvd/lang"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-nvd/lastModified> a linkml:SlotDefinition ;
	skos:closeMatch "http://purl.org/dc/terms/modified"^^xsd:anyURI , "http://schema.org/dateModified"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/nist-nvd/nvd_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/nist-nvd/lastModified"^^xsd:anyURI ;
	skos:note "A CPE name, a match string and a vendor comment carry this too, so the mappings that hold only of a vulnerability sit on NvdCve's use of it." ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-nvd/lastModified"^^xsd:anyURI ;
	linkml:description "When NVD last changed this." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-nvd/NvdCpe> , <https://w3id.org/lmodel/nist-nvd/NvdCve> , <https://w3id.org/lmodel/nist-nvd/NvdMatchString> , <https://w3id.org/lmodel/nist-nvd/NvdVendorComment> ;
	linkml:owner <https://w3id.org/lmodel/nist-nvd/NvdMatchString> ;
	linkml:range <https://w3id.org/lmodel/nist-nvd/nvd_timestamp> ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-nvd/lastModified"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-nvd/lessThan> a linkml:SlotDefinition ;
	linkml:description "The first version after the range." ;
	linkml:pattern "^[\\s\\S]{1,1024}$" ;
	linkml:value_presence "ABSENT" , "PRESENT" .
<https://w3id.org/lmodel/nist-nvd/lessThanOrEqual> a linkml:SlotDefinition ;
	linkml:description "The last version in the range." ;
	linkml:pattern "^[\\s\\S]{1,1024}$" ;
	linkml:value_presence "ABSENT" , "PRESENT" .
