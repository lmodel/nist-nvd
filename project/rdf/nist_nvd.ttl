	linkml:domain_of <https://w3id.org/lmodel/nist-nvd/NvdSsvcMetricV203> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/nist-nvd/NvdSsvcMetricV203> ;
	linkml:range <https://w3id.org/lmodel/nist-nvd/NvdSsvcData> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-nvd/ssvcData"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-nvd/nvdSsvcOption__automatable> a linkml:SlotDefinition ;
	skos:editorialNote "CVSS 4.0's Automatable differs from this key only by case, so the two share one page of the generated docs on a case-insensitive filesystem. Both are real keys, so neither is renamed, and tests/test_schema_rules.py pins this as the one such pair." ;
	skos:inScheme "https://w3id.org/lmodel/nist-nvd/nvd_cve"^^xsd:anyURI ;
	skos:prefLabel "automatable" ;
	linkml:any_of _:c14n262 , _:c14n53 ;
	linkml:description "Whether an attacker could automate the attack, as yes or no." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-nvd/NvdSsvcOption> ;
	linkml:owner <https://w3id.org/lmodel/nist-nvd/NvdSsvcOption> ;
	linkml:range <https://w3id.org/lmodel/nist-nvd/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-nvd/automatable"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-nvd/nvdSsvcOption__exploitation> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-nvd/nvd_cve"^^xsd:anyURI ;
	skos:prefLabel "exploitation" ;
	linkml:any_of _:c14n135 , _:c14n20 ;
	linkml:description "How far the vulnerability is known to be exploited, such as none, poc or active." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-nvd/NvdSsvcOption> ;
	linkml:owner <https://w3id.org/lmodel/nist-nvd/NvdSsvcOption> ;
	linkml:range <https://w3id.org/lmodel/nist-nvd/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-nvd/exploitation"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-nvd/nvdSsvcOption__technicalImpact> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-nvd/nvd_cve"^^xsd:anyURI ;
	skos:prefLabel "technicalImpact" ;
	linkml:any_of _:c14n122 , _:c14n209 ;
	linkml:description "How much control an attacker would gain, as partial or total." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-nvd/NvdSsvcOption> ;
	linkml:owner <https://w3id.org/lmodel/nist-nvd/NvdSsvcOption> ;
	linkml:range <https://w3id.org/lmodel/nist-nvd/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-nvd/technicalImpact"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-nvd/nvdVendorComment__comment> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-nvd/nvd_cve"^^xsd:anyURI ;
	skos:prefLabel "comment" ;
	linkml:description "What the vendor said." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-nvd/NvdVendorComment> ;
	linkml:owner <https://w3id.org/lmodel/nist-nvd/NvdVendorComment> ;
	linkml:range <https://w3id.org/lmodel/nist-nvd/string> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-nvd/comment"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-nvd/nvdVendorComment__organization> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-nvd/nvd_cve"^^xsd:anyURI ;
	skos:prefLabel "organization" ;
	linkml:description "The vendor's name." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-nvd/NvdVendorComment> ;
	linkml:owner <https://w3id.org/lmodel/nist-nvd/NvdVendorComment> ;
	linkml:range <https://w3id.org/lmodel/nist-nvd/string> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-nvd/organization"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-nvd/nvdVulnerability__cve> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-nvd/nvd_cve"^^xsd:anyURI ;
	skos:prefLabel "cve" ;
	linkml:description "The vulnerability." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-nvd/NvdVulnerability> ;
	linkml:inlined true ;
	linkml:owner <https://w3id.org/lmodel/nist-nvd/NvdVulnerability> ;
	linkml:range <https://w3id.org/lmodel/nist-nvd/NvdCve> ;
