	skos:exactMatch "kev_catalog:dueDate"^^xsd:anyURI ;
	skos:note "Equal to the catalog's value for all 1,766 entries of the catalog of 2026-11-03, read through the API." ;
	linkml:description "The day by which CISA says federal agencies must act." ;
	linkml:range <https://w3id.org/lmodel/nist-nvd/date> .
<https://w3id.org/lmodel/nist-nvd/cisaExploitAdd> a linkml:SlotDefinition ;
	skos:exactMatch "kev_catalog:dateAdded"^^xsd:anyURI ;
	skos:note "Equal to the catalog's value for all 1,766 entries of the catalog of 2026-11-03, read through the API." ;
