	linkml:definition_uri "https://w3id.org/lmodel/nist-nvd/NvdVulnerability"^^xsd:anyURI ;
	linkml:description "One entry of a response, which only wraps the vulnerability." ;
	linkml:slot_usage _:c14n200 ;
	linkml:slots <https://w3id.org/lmodel/nist-nvd/nvdVulnerability__cve> .
<https://w3id.org/lmodel/nist-nvd/NvdWeakness> a linkml:ClassDefinition ;
	skos:altLabel "weakness" ;
	skos:closeMatch "cve:CveProblemType"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/nist-nvd/nvd_cve"^^xsd:anyURI ;
	linkml:annotations _:c14n259 ;
	linkml:class_uri "https://w3id.org/lmodel/nist-nvd/NvdWeakness"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-nvd/NvdWeakness"^^xsd:anyURI ;
