<https://w3id.org/lmodel/nist-nvd/nvdAffectedProduct__cpes> a linkml:SlotDefinition ;
	skos:closeMatch "https://w3id.org/lmodel/cve/cpes"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/nist-nvd/nvd_cve"^^xsd:anyURI ;
	skos:note "NVD's own pattern, with its quotes written as \\x22 and \\x27, which mean the same. The Python generators cut a raw string at a quote." ;
	skos:prefLabel "cpes" ;
	linkml:description "The product's CPE names, in the 2.2 or the 2.3 form." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-nvd/NvdAffectedProduct> ;
	linkml:list_elements_unique true ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/nist-nvd/NvdAffectedProduct> ;
	linkml:pattern "([c][pP][eE]:/[AHOaho]?(:[A-Za-z0-9._\\-~%]*){0,6})|(cpe:2\\.3:[aho*\\-](:(((\\?*|\\*?)([a-zA-Z0-9\\-._]|(\\\\[\\\\*?!\\x22#$%&\\x27()+,/:;<=>@\\[\\]\\^`{|}~]))+(\\?*|\\*?))|[*\\-])){5}(:(([a-zA-Z]{2,3}(-([a-zA-Z]{2}|[0-9]{3}))?)|[*\\-]))(:(((\\?*|\\*?)([a-zA-Z0-9\\-._]|(\\\\[\\\\*?!\\x22#$%&\\x27()+,/:;<=>@\\[\\]\\^`{|}~]))+(\\?*|\\*?))|[*\\-])){4})" ;
	linkml:range <https://w3id.org/lmodel/nist-nvd/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-nvd/cpes"^^xsd:anyURI .
