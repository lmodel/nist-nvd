	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/nist-nvd/NvdCpeNameLink> .
<https://w3id.org/lmodel/nist-nvd/deprecates> a linkml:SlotDefinition ;
