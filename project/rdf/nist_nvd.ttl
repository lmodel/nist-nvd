<https://w3id.org/lmodel/nist-nvd/cpeName> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-nvd/nvd_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/nist-nvd/cpeName"^^xsd:anyURI ;
	skos:note "SPDX 3.0.1 names CPE 2.3 as one kind of external identifier. That term is the kind, not a property that holds the name, so it is only related." ;
