<https://w3id.org/lmodel/nist-nvd/cvssV20__accessComplexity> a linkml:SlotDefinition ;
	skos:closeMatch "http://w3id.org/sepses/vocab/ref/cvss#accessComplexity"^^xsd:anyURI ;
