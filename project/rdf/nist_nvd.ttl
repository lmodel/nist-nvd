<https://w3id.org/lmodel/nist-nvd/CvssV40> a linkml:ClassDefinition ;
	skos:broadMatch "sepses_cvss:CVSS"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/cve/cve_cvss"^^xsd:anyURI ;
	skos:note "The upstream's rules name threatScore, threatSeverity, environmentalScore and environmentalSeverity, but its list of properties has none of them and it refuses any other key, so a score object cannot carry them and this class has no such slots." ;
