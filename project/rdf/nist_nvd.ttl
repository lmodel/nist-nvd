	linkml:range <https://w3id.org/lmodel/nist-nvd/NvdCpeNameLink> .
<https://w3id.org/lmodel/nist-nvd/description> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-nvd/nvd_cve"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/nist-nvd/description"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-nvd/description"^^xsd:anyURI ;
	linkml:description "The weakness, as language-tagged text, usually a CWE identifier." ;
