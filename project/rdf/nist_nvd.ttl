	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/nist-nvd/NvdChangeDetail> .
<https://w3id.org/lmodel/nist-nvd/disputed> linkml:description "A party disputes that this is a vulnerability." .
<https://w3id.org/lmodel/nist-nvd/double> a linkml:TypeDefinition ;
	skos:closeMatch "schema:Float"^^xsd:anyURI ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"double\"." ;
