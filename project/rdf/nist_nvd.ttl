	skos:closeMatch "http://w3id.org/sepses/vocab/ref/cvss#integrityImpact"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/cve/cve_cvss"^^xsd:anyURI ;
	linkml:annotations _:c14n75 ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/integrityImpact"^^xsd:anyURI ;
