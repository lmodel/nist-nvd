	linkml:definition_uri "https://w3id.org/lmodel/nist-nvd/impactScore"^^xsd:anyURI ;
	linkml:description "The CVSS impact subscore." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-nvd/NvdCvssMetricV2> , <https://w3id.org/lmodel/nist-nvd/NvdCvssMetricV30> , <https://w3id.org/lmodel/nist-nvd/NvdCvssMetricV31> ;
	linkml:maximum_value "10"^^linkml:\@id ;
	linkml:minimum_value "0"^^linkml:\@id ;
	linkml:owner <https://w3id.org/lmodel/nist-nvd/NvdCvssMetricV31> ;
	linkml:range <https://w3id.org/lmodel/nist-nvd/float> ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-nvd/impactScore"^^xsd:anyURI .
