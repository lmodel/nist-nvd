<https://w3id.org/lmodel/nist-nvd/nist_nvd> dcterms:license "Apache-2.0" ;
	dcterms:source "https://csrc.nist.gov/schema/nvd/api/2.0/cve_api_json_2.0.schema"^^xsd:anyURI ;
	dcterms:title "National Vulnerability Database (NVD)" ;
	pav:version "2.2.4" ;
	schema1:keywords "CPE" , "CVE" , "CVSS" , "NVD" , "vulnerability" ;
	a linkml:SchemaDefinition ;
	rdfs:seeAlso "https://lmodel.github.io/nist-nvd"^^xsd:anyURI , "https://nvd.nist.gov/developers/start-here"^^xsd:anyURI ;
	skos:note "NVD has four kinds of response and no document that holds them, so each response module marks its own response as a tree root, and the generators write NvdCveResponse as the top class. Name the kind when validating, with linkml-validate -C NvdCpeResponse." , "The version is the edition of NVD's vulnerability schema, as its title names it. Each module's header carries the edition of its own schema: 2.0 for the product and match-string responses, and 2.0.1 for the change history. scripts/check_upstream_release.py compares each file's SHA-256 with its pin, since NIST changes them in place with no release." ;
	sh:declare _:c14n54 , _:c14n89 ;
	linkml:annotations _:c14n303 ;
