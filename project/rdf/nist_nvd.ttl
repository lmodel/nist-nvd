	linkml:description "The name NVD gives this kind of response." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-nvd/NvdResponseMixin> ;
	linkml:owner <https://w3id.org/lmodel/nist-nvd/NvdResponseMixin> ;
	linkml:range <https://w3id.org/lmodel/nist-nvd/string> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-nvd/format"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-nvd/generator> a linkml:SlotDefinition ;
	linkml:description "The tool that wrote this decision." .
<https://w3id.org/lmodel/nist-nvd/id> a linkml:SlotDefinition ;
	skos:closeMatch "http://purl.org/dc/terms/identifier"^^xsd:anyURI ;
	skos:exactMatch "http://www.wikidata.org/prop/direct/P3587"^^xsd:anyURI , "https://w3id.org/lmodel/cve/cveId"^^xsd:anyURI , "https://w3id.org/lmodel/kev-catalog/cveID"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/nist-nvd/nvd_cve"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/nist-nvd/id"^^xsd:anyURI ;
	skos:note "Every CVE identifier in the KEV catalog of 2026-11-03 is the id of one record the API marks as known exploited, and the reverse." , "Wikidata's P3587 holds the same identifier in the same form, on the item for the vulnerability." ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-nvd/id"^^xsd:anyURI ;
	linkml:description "The vulnerability the decision is about, by whatever identifier." , "The vulnerability's CVE identifier." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-nvd/NvdCve> ;
	linkml:identifier true ;
	linkml:owner <https://w3id.org/lmodel/nist-nvd/NvdCve> ;
	linkml:range <https://w3id.org/lmodel/nist-nvd/nvd_cve_identifier> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-nvd/id"^^xsd:anyURI , "nist_nvd:ssvcSubject"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-nvd/impactScore> a linkml:SlotDefinition ;
