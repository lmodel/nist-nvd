	linkml:permissible_values <https://w3id.org/lmodel/nist-nvd/NO> , <https://w3id.org/lmodel/nist-nvd/NOT_DEFINED> , <https://w3id.org/lmodel/nist-nvd/YES> .
<https://w3id.org/lmodel/nist-nvd/CvssV4ExploitMaturity> skos:inScheme "https://w3id.org/lmodel/cve/cve_cvss"^^xsd:anyURI ;
	linkml:annotations _:c14n140 ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/CvssV4ExploitMaturity"^^xsd:anyURI ;
	linkml:description "How much is known about attacks on the flaw." ;
	linkml:permissible_values <https://w3id.org/lmodel/nist-nvd/ATTACKED> , <https://w3id.org/lmodel/nist-nvd/NOT_DEFINED> , <https://w3id.org/lmodel/nist-nvd/PROOF_OF_CONCEPT> , <https://w3id.org/lmodel/nist-nvd/UNREPORTED> .
<https://w3id.org/lmodel/nist-nvd/CvssV4ModifiedAttackRequirements> skos:inScheme "https://w3id.org/lmodel/cve/cve_cvss"^^xsd:anyURI ;
	linkml:annotations _:c14n308 ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/CvssV4ModifiedAttackRequirements"^^xsd:anyURI ;
	linkml:description "The attack requirements as the scorer's environment changes them." ;
	linkml:permissible_values <https://w3id.org/lmodel/nist-nvd/NONE> , <https://w3id.org/lmodel/nist-nvd/NOT_DEFINED> , <https://w3id.org/lmodel/nist-nvd/PRESENT> .
<https://w3id.org/lmodel/nist-nvd/CvssV4ModifiedAttackVector> skos:inScheme "https://w3id.org/lmodel/cve/cve_cvss"^^xsd:anyURI ;
	linkml:annotations _:c14n152 ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/CvssV4ModifiedAttackVector"^^xsd:anyURI ;
	linkml:description "The attack vector as the scorer's environment changes it, in CVSS 4.0's terms." ;
	linkml:permissible_values <https://w3id.org/lmodel/nist-nvd/ADJACENT> , <https://w3id.org/lmodel/nist-nvd/LOCAL> , <https://w3id.org/lmodel/nist-nvd/NETWORK> , <https://w3id.org/lmodel/nist-nvd/NOT_DEFINED> , <https://w3id.org/lmodel/nist-nvd/PHYSICAL> .
<https://w3id.org/lmodel/nist-nvd/CvssV4ModifiedSubsequentImpact> skos:inScheme "https://w3id.org/lmodel/cve/cve_cvss"^^xsd:anyURI ;
	linkml:annotations _:c14n28 ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/CvssV4ModifiedSubsequentImpact"^^xsd:anyURI ;
	linkml:description "The integrity or availability impact on connected systems as the scorer's environment changes it, which may include a risk to safety." ;
	linkml:permissible_values <https://w3id.org/lmodel/nist-nvd/HIGH> , <https://w3id.org/lmodel/nist-nvd/LOW> , <https://w3id.org/lmodel/nist-nvd/NONE> , <https://w3id.org/lmodel/nist-nvd/NOT_DEFINED> , <https://w3id.org/lmodel/nist-nvd/SAFETY> .
<https://w3id.org/lmodel/nist-nvd/CvssV4ModifiedUserInteraction> skos:inScheme "https://w3id.org/lmodel/cve/cve_cvss"^^xsd:anyURI ;
	linkml:annotations _:c14n111 ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/CvssV4ModifiedUserInteraction"^^xsd:anyURI ;
	linkml:description "The user interaction as the scorer's environment changes it, in CVSS 4.0's terms." ;
	linkml:permissible_values <https://w3id.org/lmodel/nist-nvd/ACTIVE> , <https://w3id.org/lmodel/nist-nvd/NONE> , <https://w3id.org/lmodel/nist-nvd/NOT_DEFINED> , <https://w3id.org/lmodel/nist-nvd/PASSIVE> .
<https://w3id.org/lmodel/nist-nvd/CvssV4ProviderUrgency> skos:inScheme "https://w3id.org/lmodel/cve/cve_cvss"^^xsd:anyURI ;
	linkml:annotations _:c14n228 ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/CvssV4ProviderUrgency"^^xsd:anyURI ;
	linkml:description "How urgent the product's supplier says the flaw is, as a colour." ;
	linkml:permissible_values <https://w3id.org/lmodel/nist-nvd/AMBER> , <https://w3id.org/lmodel/nist-nvd/CLEAR> , <https://w3id.org/lmodel/nist-nvd/GREEN> , <https://w3id.org/lmodel/nist-nvd/NOT_DEFINED> , <https://w3id.org/lmodel/nist-nvd/RED> .
<https://w3id.org/lmodel/nist-nvd/CvssV4Recovery> skos:inScheme "https://w3id.org/lmodel/cve/cve_cvss"^^xsd:anyURI ;
	linkml:annotations _:c14n118 ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/CvssV4Recovery"^^xsd:anyURI ;
	linkml:description "How the affected system comes back after an attack." ;
	linkml:permissible_values <https://w3id.org/lmodel/nist-nvd/AUTOMATIC> , <https://w3id.org/lmodel/nist-nvd/IRRECOVERABLE> , <https://w3id.org/lmodel/nist-nvd/NOT_DEFINED> , <https://w3id.org/lmodel/nist-nvd/USER> .
<https://w3id.org/lmodel/nist-nvd/CvssV4ResponseEffort> skos:inScheme "https://w3id.org/lmodel/cve/cve_cvss"^^xsd:anyURI ;
	linkml:annotations _:c14n254 ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/CvssV4ResponseEffort"^^xsd:anyURI ;
	linkml:description "How much work it takes a consumer to respond to the flaw." ;
	linkml:permissible_values <https://w3id.org/lmodel/nist-nvd/HIGH> , <https://w3id.org/lmodel/nist-nvd/LOW> , <https://w3id.org/lmodel/nist-nvd/MODERATE> , <https://w3id.org/lmodel/nist-nvd/NOT_DEFINED> .
<https://w3id.org/lmodel/nist-nvd/CvssV4Safety> skos:inScheme "https://w3id.org/lmodel/cve/cve_cvss"^^xsd:anyURI ;
	linkml:annotations _:c14n143 ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/CvssV4Safety"^^xsd:anyURI ;
	linkml:description "Whether an attack could put people's safety at risk." ;
	linkml:permissible_values <https://w3id.org/lmodel/nist-nvd/NEGLIGIBLE> , <https://w3id.org/lmodel/nist-nvd/NOT_DEFINED> , <https://w3id.org/lmodel/nist-nvd/PRESENT> .
<https://w3id.org/lmodel/nist-nvd/CvssV4UserInteraction> skos:inScheme "https://w3id.org/lmodel/cve/cve_cvss"^^xsd:anyURI ;
	linkml:annotations _:c14n91 ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/CvssV4UserInteraction"^^xsd:anyURI ;
	linkml:description "Whether someone else has to take part, in CVSS 4.0's terms." ;
	linkml:permissible_values <https://w3id.org/lmodel/nist-nvd/ACTIVE> , <https://w3id.org/lmodel/nist-nvd/NONE> , <https://w3id.org/lmodel/nist-nvd/PASSIVE> .
<https://w3id.org/lmodel/nist-nvd/CvssV4ValueDensity> skos:inScheme "https://w3id.org/lmodel/cve/cve_cvss"^^xsd:anyURI ;
	linkml:annotations _:c14n252 ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/CvssV4ValueDensity"^^xsd:anyURI ;
	linkml:description "How much of a resource one successful attack gains the attacker." ;
	linkml:permissible_values <https://w3id.org/lmodel/nist-nvd/CONCENTRATED> , <https://w3id.org/lmodel/nist-nvd/DIFFUSE> , <https://w3id.org/lmodel/nist-nvd/NOT_DEFINED> .
<https://w3id.org/lmodel/nist-nvd/DIFFUSE> linkml:description "Each target holds little, so an attacker must take many." .
<https://w3id.org/lmodel/nist-nvd/Deferred> linkml:description "NVD has put off analysing the record." .
<https://w3id.org/lmodel/nist-nvd/Exploit> linkml:description "The page shows or gives a way to exploit the vulnerability." .
<https://w3id.org/lmodel/nist-nvd/FUNCTIONAL> linkml:description "Working attack code exists for most situations." .
<https://w3id.org/lmodel/nist-nvd/GREEN> linkml:description "The supplier says the flaw can wait for regular work." .
<https://w3id.org/lmodel/nist-nvd/HIGH> linkml:description "A loss would have catastrophic effect." , "Administrator-level access." , "All of it is lost, or the loss has serious consequences." , "Attack code is reliable and widely available, or no code is needed." , "Catastrophic loss." , "More than about three quarters of systems." , "Much work, or a long outage." , "Only under unusual, hard-to-arrange conditions." , "Success depends on conditions the attacker must overcome or wait for." , "The high band of CVSS 2.0 base scores." , "The rating below critical." ;
	linkml:meaning "spdx_security:CvssSeverityType/high"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-nvd/IRRECOVERABLE> linkml:description "The system cannot be restored." .
<https://w3id.org/lmodel/nist-nvd/Inactive> linkml:description "NVD no longer uses this match string." .
<https://w3id.org/lmodel/nist-nvd/Issue%20Tracking> linkml:description "An entry in a bug or issue tracker." .
<https://w3id.org/lmodel/nist-nvd/LOCAL> linkml:description "Only by acting on the system itself, directly or through a user." , "Only with an account on the system or hands on it." .
<https://w3id.org/lmodel/nist-nvd/LOW> linkml:description "A loss would have limited effect." , "Little work, such as reading advice or a small configuration change." , "Ordinary user access." , "Slight loss." , "Some is lost, with limited consequences." , "The attacker can succeed again and again with no special effort." , "The low band of CVSS 2.0 base scores." , "The lowest rating above none." , "Up to about a quarter of systems." , "With no special conditions." ;
	linkml:meaning "spdx_security:CvssSeverityType/low"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-nvd/LOW_MEDIUM> linkml:description "Moderate loss." .
<https://w3id.org/lmodel/nist-nvd/MEDIUM> linkml:description "A loss would have serious effect." , "About a quarter to three quarters of systems." , "The middle band of CVSS 2.0 base scores." , "The middle rating." , "Under conditions that take some arranging." ;
	linkml:meaning "spdx_security:CvssSeverityType/medium"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-nvd/MEDIUM_HIGH> linkml:description "Significant loss." .
<https://w3id.org/lmodel/nist-nvd/MODERATE> linkml:description "Some work, with a noticeable effect on the service." .
<https://w3id.org/lmodel/nist-nvd/MULTIPLE> linkml:description "More than one login." .
<https://w3id.org/lmodel/nist-nvd/Mailing%20List> linkml:description "A message in a mailing list archive." .
<https://w3id.org/lmodel/nist-nvd/Mitigation> linkml:description "The page says how to reduce the risk without a fix." .
<https://w3id.org/lmodel/nist-nvd/Modified> linkml:description "The record has changed since NVD analysed it." .
<https://w3id.org/lmodel/nist-nvd/NEGLIGIBLE> linkml:description "Any harm to people would be slight at most." .
<https://w3id.org/lmodel/nist-nvd/NETWORK> linkml:description "From anywhere that can route to the system." .
<https://w3id.org/lmodel/nist-nvd/NO> linkml:description "At least one step resists automation." .
<https://w3id.org/lmodel/nist-nvd/NONE> linkml:description "No access at all." , "No login at all." , "No severity at all, for a score of 0." , "No such loss." , "No systems at all, or only in a lab." , "Nothing is lost." , "The attack needs nobody else." , "The attack works whatever the target's state." ;
	linkml:meaning "spdx_security:CvssSeverityType/none"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-nvd/NOT_DEFINED> linkml:description "The scorer gave no value, so the base metric stands." , "The scorer gave no value, so the metric does not change the score." , "The scorer gave no value, so the worst case is assumed." , "The scorer gave no value." .
<https://w3id.org/lmodel/nist-nvd/Not%20Applicable> linkml:description "The page does not bear on the vulnerability." .
<https://w3id.org/lmodel/nist-nvd/NvdAffected> a linkml:ClassDefinition ;
	skos:altLabel "affected" ;
	skos:inScheme "https://w3id.org/lmodel/nist-nvd/nvd_cve"^^xsd:anyURI ;
	linkml:annotations _:c14n86 ;
	linkml:attributes <https://w3id.org/lmodel/nist-nvd/affectedData> ;
	linkml:class_uri "https://w3id.org/lmodel/nist-nvd/NvdAffected"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-nvd/NvdAffected"^^xsd:anyURI ;
	linkml:description "The products that one source says the vulnerability affects." ;
	linkml:slot_usage _:c14n157 ;
	linkml:slots <https://w3id.org/lmodel/nist-nvd/NvdAffected_source> , <https://w3id.org/lmodel/nist-nvd/nvdAffected__affectedData> .
<https://w3id.org/lmodel/nist-nvd/NvdAffectedProduct> a linkml:ClassDefinition ;
	skos:closeMatch "cve:CveProduct"^^xsd:anyURI ;
	skos:editorialNote "NVD's file has the same keys as the CVE Record Format's product. It drops the two rules that the CVE format states, that a product names a vendor and product or a collection and package, and that it has versions or a default status, so this class does not state them. The default status keeps NVD's own enum beside it, so nvd_cve needs no second copy of the CVE module." ;
	skos:inScheme "https://w3id.org/lmodel/nist-nvd/nvd_cve"^^xsd:anyURI ;
	linkml:annotations _:c14n99 ;
	linkml:attributes <https://w3id.org/lmodel/nist-nvd/collectionURL> , <https://w3id.org/lmodel/nist-nvd/cpes> , <https://w3id.org/lmodel/nist-nvd/modules> , <https://w3id.org/lmodel/nist-nvd/packageName> , <https://w3id.org/lmodel/nist-nvd/packageURL> , <https://w3id.org/lmodel/nist-nvd/platforms> , <https://w3id.org/lmodel/nist-nvd/product> , <https://w3id.org/lmodel/nist-nvd/programFiles> , <https://w3id.org/lmodel/nist-nvd/programRoutines> , <https://w3id.org/lmodel/nist-nvd/repo> , <https://w3id.org/lmodel/nist-nvd/vendor> , <https://w3id.org/lmodel/nist-nvd/versions> ;
	linkml:class_uri "https://w3id.org/lmodel/nist-nvd/NvdAffectedProduct"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-nvd/NvdAffectedProduct"^^xsd:anyURI ;
	linkml:description "A product and which of its versions have the vulnerability." ;
	linkml:slot_usage _:c14n173 ;
	linkml:slots <https://w3id.org/lmodel/nist-nvd/defaultStatus> , <https://w3id.org/lmodel/nist-nvd/nvdAffectedProduct__collectionURL> , <https://w3id.org/lmodel/nist-nvd/nvdAffectedProduct__cpes> , <https://w3id.org/lmodel/nist-nvd/nvdAffectedProduct__modules> , <https://w3id.org/lmodel/nist-nvd/nvdAffectedProduct__packageName> , <https://w3id.org/lmodel/nist-nvd/nvdAffectedProduct__packageURL> , <https://w3id.org/lmodel/nist-nvd/nvdAffectedProduct__platforms> , <https://w3id.org/lmodel/nist-nvd/nvdAffectedProduct__product> , <https://w3id.org/lmodel/nist-nvd/nvdAffectedProduct__programFiles> , <https://w3id.org/lmodel/nist-nvd/nvdAffectedProduct__programRoutines> , <https://w3id.org/lmodel/nist-nvd/nvdAffectedProduct__repo> , <https://w3id.org/lmodel/nist-nvd/nvdAffectedProduct__vendor> , <https://w3id.org/lmodel/nist-nvd/nvdAffectedProduct__versions> .
<https://w3id.org/lmodel/nist-nvd/NvdAffectedVersion> a linkml:ClassDefinition ;
	skos:closeMatch "cve:CveProductVersion"^^xsd:anyURI ;
	skos:editorialNote "These four rules state the oneOf of NVD's file, which has four branches: a version and a status alone, those with a numbering scheme, and those with a scheme and one of the two limits." ;
	skos:inScheme "https://w3id.org/lmodel/nist-nvd/nvd_cve"^^xsd:anyURI ;
	sh:rule _:c14n11 , _:c14n169 , _:c14n301 , _:c14n70 ;
	linkml:annotations _:c14n185 ;
	linkml:attributes <https://w3id.org/lmodel/nist-nvd/changes> , <https://w3id.org/lmodel/nist-nvd/lessThan> , <https://w3id.org/lmodel/nist-nvd/lessThanOrEqual> , <https://w3id.org/lmodel/nist-nvd/versionType> ;
	linkml:class_uri "https://w3id.org/lmodel/nist-nvd/NvdAffectedVersion"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-nvd/NvdAffectedVersion"^^xsd:anyURI ;
	linkml:description "The status of one version of a product, or of a range of its versions." ;
	linkml:slot_usage _:c14n309 ;
	linkml:slots <https://w3id.org/lmodel/nist-nvd/NvdAffectedVersion_status> , <https://w3id.org/lmodel/nist-nvd/NvdAffectedVersion_version> , <https://w3id.org/lmodel/nist-nvd/nvdAffectedVersion__changes> , <https://w3id.org/lmodel/nist-nvd/nvdAffectedVersion__lessThan> , <https://w3id.org/lmodel/nist-nvd/nvdAffectedVersion__lessThanOrEqual> , <https://w3id.org/lmodel/nist-nvd/nvdAffectedVersion__versionType> .
<https://w3id.org/lmodel/nist-nvd/NvdAffectedVersion_status> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-nvd/nvd_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/nist-nvd/status"^^xsd:anyURI ;
	skos:prefLabel "status" ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-nvd/status"^^xsd:anyURI ;
	linkml:description "The state of this thing, from the list its class names." ;
	linkml:domain <https://w3id.org/lmodel/nist-nvd/NvdAffectedVersion> ;
	linkml:domain_of <https://w3id.org/lmodel/nist-nvd/NvdAffectedVersion> ;
	linkml:is_a <https://w3id.org/lmodel/nist-nvd/status> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/nist-nvd/NvdAffectedVersion> ;
	linkml:range <https://w3id.org/lmodel/nist-nvd/NvdVersionStatus> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-nvd/status"^^xsd:anyURI ;
	linkml:usage_slot_name "status" .
<https://w3id.org/lmodel/nist-nvd/NvdAffectedVersion_version> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/cve/cve_cvss"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/cve/version"^^xsd:anyURI ;
	skos:note "Each class that uses it narrows it. A top-level slot, so that lokf adapt renames it beside LOKF's version." ;
	skos:prefLabel "version" ;
	linkml:annotations _:c14n318 ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/version"^^xsd:anyURI ;
	linkml:description "The version, or the start of the range." ;
	linkml:domain <https://w3id.org/lmodel/nist-nvd/NvdAffectedVersion> ;
	linkml:domain_of <https://w3id.org/lmodel/nist-nvd/NvdAffectedVersion> ;
	linkml:is_a <https://w3id.org/lmodel/nist-nvd/version> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/nist-nvd/NvdAffectedVersion> ;
	linkml:pattern "^[\\s\\S]{1,1024}$" ;
	linkml:range <https://w3id.org/lmodel/nist-nvd/string> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/cve/version"^^xsd:anyURI ;
	linkml:usage_slot_name "version" .
<https://w3id.org/lmodel/nist-nvd/NvdAffected_source> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-nvd/nvd_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/nist-nvd/source"^^xsd:anyURI ;
	skos:prefLabel "source" ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-nvd/source"^^xsd:anyURI ;
	linkml:description "The email address or UUID of the organization that supplied this." ;
	linkml:domain <https://w3id.org/lmodel/nist-nvd/NvdAffected> ;
	linkml:domain_of <https://w3id.org/lmodel/nist-nvd/NvdAffected> ;
	linkml:is_a <https://w3id.org/lmodel/nist-nvd/source> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/nist-nvd/NvdAffected> ;
	linkml:range <https://w3id.org/lmodel/nist-nvd/string> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-nvd/source"^^xsd:anyURI ;
	linkml:usage_slot_name "source" .
<https://w3id.org/lmodel/nist-nvd/NvdChange> a linkml:ClassDefinition ;
	skos:altLabel "changeItem" ;
	skos:editorialNote "The identifier is set on this class and not on the slot, so that lokf adapt keeps the key beside LOKF's id, as it does for cpeNameId and matchCriteriaId." ;
	skos:inScheme "https://w3id.org/lmodel/nist-nvd/nvd_history"^^xsd:anyURI ;
	skos:note "A change is something that happened to a record, so it relates to a PROV activity, but NVD records only when and by whom, not the entities it used." ;
	skos:relatedMatch "prov:Activity"^^xsd:anyURI ;
	linkml:annotations _:c14n39 ;
	linkml:attributes <https://w3id.org/lmodel/nist-nvd/cveId> , <https://w3id.org/lmodel/nist-nvd/details> , <https://w3id.org/lmodel/nist-nvd/eventName> ;
	linkml:class_uri "https://w3id.org/lmodel/nist-nvd/NvdChange"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-nvd/NvdChange"^^xsd:anyURI ;
	linkml:description "One change to a vulnerability's record at NVD." ;
	linkml:slot_usage _:c14n248 ;
	linkml:slots <https://w3id.org/lmodel/nist-nvd/NvdChange_cveChangeId> , <https://w3id.org/lmodel/nist-nvd/NvdChange_sourceIdentifier> , <https://w3id.org/lmodel/nist-nvd/created> , <https://w3id.org/lmodel/nist-nvd/nvdChange__cveId> , <https://w3id.org/lmodel/nist-nvd/nvdChange__details> , <https://w3id.org/lmodel/nist-nvd/nvdChange__eventName> .
<https://w3id.org/lmodel/nist-nvd/NvdChangeDetail> a linkml:ClassDefinition ;
	skos:altLabel "detail" ;
	skos:inScheme "https://w3id.org/lmodel/nist-nvd/nvd_history"^^xsd:anyURI ;
	linkml:annotations _:c14n240 ;
	linkml:attributes <https://w3id.org/lmodel/nist-nvd/action> , <https://w3id.org/lmodel/nist-nvd/newValue> , <https://w3id.org/lmodel/nist-nvd/oldValue> ;
	linkml:class_uri "https://w3id.org/lmodel/nist-nvd/NvdChangeDetail"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-nvd/NvdChangeDetail"^^xsd:anyURI ;
