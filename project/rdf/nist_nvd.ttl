	linkml:slot_uri "https://w3id.org/lmodel/nist-nvd/criteria"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-nvd/curie> dcterms:conformsTo "https://www.w3.org/TR/curie/" ;
	a linkml:TypeDefinition ;
