@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix pav: <http://purl.org/pav/> .
@prefix schema1: <http://schema.org/> .
<https://w3id.org/lmodel/nist-nvd/ACTIVE> linkml:description "Someone has to take a deliberate step." .
<https://w3id.org/lmodel/nist-nvd/ADJACENT> linkml:description "Only from something logically or physically nearby." .
<https://w3id.org/lmodel/nist-nvd/ADJACENT_NETWORK> linkml:description "Only from a logically nearby network." , "Only from the same local network segment." .
<https://w3id.org/lmodel/nist-nvd/AMBER> linkml:description "The supplier says the flaw matters soon." .
<https://w3id.org/lmodel/nist-nvd/AND> linkml:description "Every part must hold." .
<https://w3id.org/lmodel/nist-nvd/ATTACKED> linkml:description "Attacks have been reported, or tools for them are public." .
<https://w3id.org/lmodel/nist-nvd/AUTOMATIC> linkml:description "The system recovers by itself." .
<https://w3id.org/lmodel/nist-nvd/Active> linkml:description "NVD uses this match string." .
<https://w3id.org/lmodel/nist-nvd/Advisory> linkml:description "A security advisory." .
<https://w3id.org/lmodel/nist-nvd/Analyzed> linkml:description "NVD has finished its analysis of the record." .
<https://w3id.org/lmodel/nist-nvd/Automatable> a linkml:SlotDefinition ;
	linkml:annotations _:c14n233 ;
	linkml:description "Whether an attacker could automate every step of an attack across many targets." ;
	linkml:ifabsent "CvssV4Automatable(NOT_DEFINED)" ;
	linkml:range <https://w3id.org/lmodel/nist-nvd/CvssV4Automatable> .
<https://w3id.org/lmodel/nist-nvd/Awaiting%20Analysis> linkml:description "NVD has the record and has not begun to analyse it." .
<https://w3id.org/lmodel/nist-nvd/Broken%20Link> linkml:description "The address no longer leads to the content." .
<https://w3id.org/lmodel/nist-nvd/CHANGED> linkml:description "The harm can reach something under another security authority." .
<https://w3id.org/lmodel/nist-nvd/CLEAR> linkml:description "The supplier sees little or no urgency." .
<https://w3id.org/lmodel/nist-nvd/COMPLETE> linkml:description "All of it is lost." .
<https://w3id.org/lmodel/nist-nvd/CONCENTRATED> linkml:description "A single target holds a lot." .
<https://w3id.org/lmodel/nist-nvd/CONFIRMED> linkml:description "The flaw is shown beyond doubt, or the vendor accepts it." , "The vendor accepts it, or a working attack shows it." .
<https://w3id.org/lmodel/nist-nvd/CRITICAL> linkml:description "The highest rating." ;
	linkml:meaning "spdx_security:CvssSeverityType/critical"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-nvd/Change%20Log> linkml:description "A list of the product's changes." .
<https://w3id.org/lmodel/nist-nvd/CvssAttackComplexity> skos:inScheme "https://w3id.org/lmodel/cve/cve_cvss"^^xsd:anyURI ;
	linkml:annotations _:c14n182 ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/CvssAttackComplexity"^^xsd:anyURI ;
	linkml:description "How much is outside the attacker's control." ;
	linkml:permissible_values <https://w3id.org/lmodel/nist-nvd/HIGH> , <https://w3id.org/lmodel/nist-nvd/LOW> .
<https://w3id.org/lmodel/nist-nvd/CvssExploitCodeMaturity> skos:inScheme "https://w3id.org/lmodel/cve/cve_cvss"^^xsd:anyURI ;
	linkml:annotations _:c14n314 ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/CvssExploitCodeMaturity"^^xsd:anyURI ;
	linkml:description "How far working attack code has come." ;
	linkml:permissible_values <https://w3id.org/lmodel/nist-nvd/FUNCTIONAL> , <https://w3id.org/lmodel/nist-nvd/HIGH> , <https://w3id.org/lmodel/nist-nvd/NOT_DEFINED> , <https://w3id.org/lmodel/nist-nvd/PROOF_OF_CONCEPT> , <https://w3id.org/lmodel/nist-nvd/UNPROVEN> .
<https://w3id.org/lmodel/nist-nvd/CvssImpact> skos:inScheme "https://w3id.org/lmodel/cve/cve_cvss"^^xsd:anyURI ;
	linkml:annotations _:c14n83 ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/CvssImpact"^^xsd:anyURI ;
	linkml:description "How much of one security property an attack could cost." ;
	linkml:permissible_values <https://w3id.org/lmodel/nist-nvd/HIGH> , <https://w3id.org/lmodel/nist-nvd/LOW> , <https://w3id.org/lmodel/nist-nvd/NONE> .
<https://w3id.org/lmodel/nist-nvd/CvssModifiedAttackComplexity> skos:inScheme "https://w3id.org/lmodel/cve/cve_cvss"^^xsd:anyURI ;
	linkml:annotations _:c14n266 ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/CvssModifiedAttackComplexity"^^xsd:anyURI ;
	linkml:description "The attack complexity as the scorer's environment changes it." ;
	linkml:permissible_values <https://w3id.org/lmodel/nist-nvd/HIGH> , <https://w3id.org/lmodel/nist-nvd/LOW> , <https://w3id.org/lmodel/nist-nvd/NOT_DEFINED> .
<https://w3id.org/lmodel/nist-nvd/CvssModifiedImpact> skos:inScheme "https://w3id.org/lmodel/cve/cve_cvss"^^xsd:anyURI ;
	linkml:annotations _:c14n269 ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/CvssModifiedImpact"^^xsd:anyURI ;
	linkml:description "The impact on one security property as the scorer's environment changes it." ;
	linkml:permissible_values <https://w3id.org/lmodel/nist-nvd/HIGH> , <https://w3id.org/lmodel/nist-nvd/LOW> , <https://w3id.org/lmodel/nist-nvd/NONE> , <https://w3id.org/lmodel/nist-nvd/NOT_DEFINED> .
<https://w3id.org/lmodel/nist-nvd/CvssModifiedPrivilegesRequired> skos:inScheme "https://w3id.org/lmodel/cve/cve_cvss"^^xsd:anyURI ;
	linkml:annotations _:c14n88 ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/CvssModifiedPrivilegesRequired"^^xsd:anyURI ;
	linkml:description "The access needed as the scorer's environment changes it." ;
	linkml:permissible_values <https://w3id.org/lmodel/nist-nvd/HIGH> , <https://w3id.org/lmodel/nist-nvd/LOW> , <https://w3id.org/lmodel/nist-nvd/NONE> , <https://w3id.org/lmodel/nist-nvd/NOT_DEFINED> .
<https://w3id.org/lmodel/nist-nvd/CvssPrivilegesRequired> skos:inScheme "https://w3id.org/lmodel/cve/cve_cvss"^^xsd:anyURI ;
	linkml:annotations _:c14n256 ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/CvssPrivilegesRequired"^^xsd:anyURI ;
	linkml:description "What access an attacker needs beforehand." ;
	linkml:permissible_values <https://w3id.org/lmodel/nist-nvd/HIGH> , <https://w3id.org/lmodel/nist-nvd/LOW> , <https://w3id.org/lmodel/nist-nvd/NONE> .
<https://w3id.org/lmodel/nist-nvd/CvssRemediationLevel> skos:inScheme "https://w3id.org/lmodel/cve/cve_cvss"^^xsd:anyURI ;
	linkml:annotations _:c14n293 ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/CvssRemediationLevel"^^xsd:anyURI ;
	linkml:description "What kind of fix is available." ;
	linkml:permissible_values <https://w3id.org/lmodel/nist-nvd/NOT_DEFINED> , <https://w3id.org/lmodel/nist-nvd/OFFICIAL_FIX> , <https://w3id.org/lmodel/nist-nvd/TEMPORARY_FIX> , <https://w3id.org/lmodel/nist-nvd/UNAVAILABLE> , <https://w3id.org/lmodel/nist-nvd/WORKAROUND> .
<https://w3id.org/lmodel/nist-nvd/CvssRequirement> skos:inScheme "https://w3id.org/lmodel/cve/cve_cvss"^^xsd:anyURI ;
	linkml:annotations _:c14n315 ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/CvssRequirement"^^xsd:anyURI ;
	linkml:description "How much one security property matters to the scorer." ;
	linkml:permissible_values <https://w3id.org/lmodel/nist-nvd/HIGH> , <https://w3id.org/lmodel/nist-nvd/LOW> , <https://w3id.org/lmodel/nist-nvd/MEDIUM> , <https://w3id.org/lmodel/nist-nvd/NOT_DEFINED> .
<https://w3id.org/lmodel/nist-nvd/CvssSeverity> skos:inScheme "https://w3id.org/lmodel/cve/cve_cvss"^^xsd:anyURI ;
	linkml:annotations _:c14n14 ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/CvssSeverity"^^xsd:anyURI ;
	linkml:description "A CVSS rating in words." ;
	linkml:permissible_values <https://w3id.org/lmodel/nist-nvd/CRITICAL> , <https://w3id.org/lmodel/nist-nvd/HIGH> , <https://w3id.org/lmodel/nist-nvd/LOW> , <https://w3id.org/lmodel/nist-nvd/MEDIUM> , <https://w3id.org/lmodel/nist-nvd/NONE> .
<https://w3id.org/lmodel/nist-nvd/CvssSeverityBandsMixin> a linkml:ClassDefinition ;
	skos:inScheme "https://w3id.org/lmodel/cve/cve_cvss"^^xsd:anyURI ;
	skos:note "The upstream also rules out a score that is not a multiple of 0.1, as a list of numbers no LinkML range can state. tests/cve_rules.py checks that." ;
	sh:rule _:c14n109 , _:c14n174 , _:c14n180 , _:c14n290 , _:c14n31 ;
	linkml:annotations _:c14n298 ;
	linkml:class_uri "https://w3id.org/lmodel/cve/CvssSeverityBandsMixin"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/CvssSeverityBandsMixin"^^xsd:anyURI ;
	linkml:description "The base score and base severity of a CVSS version with severity bands, and the bands that tie one to the other." ;
	linkml:mixin true ;
	linkml:slot_usage _:c14n9 ;
	linkml:slots <https://w3id.org/lmodel/nist-nvd/baseScore> , <https://w3id.org/lmodel/nist-nvd/baseSeverity> .
