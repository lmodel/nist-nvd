	skos:mappingRelation "https://w3id.org/lmodel/nist-nvd/defaultStatus"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-nvd/defaultStatus"^^xsd:anyURI ;
	linkml:description "The status of any version the versions list does not name." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-nvd/NvdAffectedProduct> ;
	linkml:owner <https://w3id.org/lmodel/nist-nvd/NvdAffectedProduct> ;
	linkml:range <https://w3id.org/lmodel/nist-nvd/NvdVersionStatus> ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-nvd/defaultStatus"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-nvd/deprecated> a linkml:SlotDefinition ;
	linkml:description "Whether NVD has retired this CPE name." ;
	linkml:range <https://w3id.org/lmodel/nist-nvd/boolean> ;
	linkml:required true .
<https://w3id.org/lmodel/nist-nvd/deprecatedBy> a linkml:SlotDefinition ;
	skos:closeMatch "dcterms:isReplacedBy"^^xsd:anyURI ;
	linkml:description "The CPE names that replace this one." ;
