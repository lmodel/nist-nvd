xsd:dateTime a rdfs:Datatype ;
	owl:equivalentClass _:c14n970 .
xsd:string a rdfs:Datatype ;
	owl:equivalentClass _:c14n1412 , _:c14n1414 .
<https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/critical> a owl:Class ;
	rdfs:label "CRITICAL" ;
	rdfs:subClassOf nist_nvd:CvssSeverity ;
	skos:definition "The highest rating." .
<https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/high> a owl:Class ;
	rdfs:label "HIGH" ;
	rdfs:subClassOf nist_nvd:CvssSeverity ;
	skos:definition "The rating below critical." .
<https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/low> a owl:Class ;
	rdfs:label "LOW" ;
	rdfs:subClassOf nist_nvd:CvssSeverity ;
	skos:definition "The lowest rating above none." .
<https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/medium> a owl:Class ;
	rdfs:label "MEDIUM" ;
	rdfs:subClassOf nist_nvd:CvssSeverity ;
	skos:definition "The middle rating." .
<https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/none> a owl:Class ;
	rdfs:label "NONE" ;
	rdfs:subClassOf nist_nvd:CvssSeverity ;
	skos:definition "No severity at all, for a score of 0." .
<https://w3id.org/lmodel/cve/Automatable> a owl:ObjectProperty ;
	rdfs:label "Automatable" ;
	skos:definition "Whether an attacker could automate every step of an attack across many targets." ;
	skos:inScheme <https://w3id.org/lmodel/cve/cve_cvss> ;
	nist_nvd:upstream_path "imports/cvss/cvss-v4.0.json#/properties/Automatable" .
<https://w3id.org/lmodel/cve/CvssSeverityBandsMixin> a owl:Class ;
	rdfs:label "CvssSeverityBandsMixin" ;
	rdfs:subClassOf _:c14n181 , _:c14n747 , _:c14n849 , _:c14n85 , _:c14n862 , _:c14n976 ;
	skos:definition "The base score and base severity of a CVSS version with severity bands, and the bands that tie one to the other." ;
	skos:inScheme <https://w3id.org/lmodel/cve/cve_cvss> ;
	skos:note "The upstream also rules out a score that is not a multiple of 0.1, as a list of numbers no LinkML range can state. tests/cve_rules.py checks that." ;
	nist_nvd:upstream_path "imports/cvss/cvss-v3.0.json#/anyOf imports/cvss/cvss-v3.1.json#/anyOf imports/cvss/cvss-v4.0.json#/allOf/0/anyOf" .
