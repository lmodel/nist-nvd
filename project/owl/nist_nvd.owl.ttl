<https://w3id.org/lmodel/nist-nvd.owl.ttl> dcterms:license "Apache-2.0" ;
	dcterms:source <https://csrc.nist.gov/schema/nvd/api/2.0/cve_api_json_2.0.schema> ;
	dcterms:title "National Vulnerability Database (NVD)" ;
	pav:version "2.2.4" ;
	<http://schema.org/keywords> "CPE" , "CVE" , "CVSS" , "NVD" , "vulnerability" ;
	a owl:Ontology ;
	rdfs:label "nist_nvd" ;
	rdfs:seeAlso <https://lmodel.github.io/nist-nvd> , <https://nvd.nist.gov/developers/start-here> ;
	skos:definition "A LinkML model of the JSON responses of the NVD API 2.0, from the JSON schemas NIST publishes: vulnerabilities, products, match strings and change history. NVD's own keys are the schema's keys, so a real response validates unchanged." ;
	skos:note "NVD has four kinds of response and no document that holds them, so each response module marks its own response as a tree root, and the generators write NvdCveResponse as the top class. Name the kind when validating, with linkml-validate -C NvdCpeResponse." , "The version is the edition of NVD's vulnerability schema, as its title names it. Each module's header carries the edition of its own schema: 2.0 for the product and match-string responses, and 2.0.1 for the change history. scripts/check_upstream_release.py compares each file's SHA-256 with its pin, since NIST changes them in place with no release." ;
	nist_nvd:upstream_sha256 "2b9c4e8ab7e6e42aa17ea787f58167beff47c119c6f291405f86ac19c6149e01" .
nist_nvd:CvssAttackComplexity\#HIGH a owl:Class ;
	rdfs:label "HIGH" ;
	rdfs:subClassOf nist_nvd:CvssAttackComplexity ;
	skos:definition "Success depends on conditions the attacker must overcome or wait for." .
nist_nvd:CvssAttackComplexity\#LOW a owl:Class ;
	rdfs:label "LOW" ;
	rdfs:subClassOf nist_nvd:CvssAttackComplexity ;
	skos:definition "The attacker can succeed again and again with no special effort." .
nist_nvd:CvssAttackComplexity a owl:Class ;
	rdfs:label "CvssAttackComplexity" ;
	owl:unionOf _:c14n954 ;
	skos:definition "How much is outside the attacker's control." ;
	skos:inScheme <https://w3id.org/lmodel/cve/cve_cvss> ;
	linkml:permissible_values nist_nvd:CvssAttackComplexity\#HIGH , nist_nvd:CvssAttackComplexity\#LOW ;
	nist_nvd:upstream_path "imports/cvss/cvss-v3.0.json#/definitions/attackComplexityType imports/cvss/cvss-v3.1.json#/definitions/attackComplexityType imports/cvss/cvss-v4.0.json#/definitions/attackComplexityType" .
nist_nvd:CvssExploitCodeMaturity\#FUNCTIONAL a owl:Class ;
	rdfs:label "FUNCTIONAL" ;
	rdfs:subClassOf nist_nvd:CvssExploitCodeMaturity ;
	skos:definition "Working attack code exists for most situations." .
nist_nvd:CvssExploitCodeMaturity\#HIGH a owl:Class ;
	rdfs:label "HIGH" ;
	rdfs:subClassOf nist_nvd:CvssExploitCodeMaturity ;
	skos:definition "Attack code is reliable and widely available, or no code is needed." .
nist_nvd:CvssExploitCodeMaturity\#NOT_DEFINED a owl:Class ;
	rdfs:label "NOT_DEFINED" ;
	rdfs:subClassOf nist_nvd:CvssExploitCodeMaturity ;
	skos:definition "The scorer gave no value, so the metric does not change the score." .
nist_nvd:CvssExploitCodeMaturity\#PROOF_OF_CONCEPT a owl:Class ;
	rdfs:label "PROOF_OF_CONCEPT" ;
	rdfs:subClassOf nist_nvd:CvssExploitCodeMaturity ;
	skos:definition "A demonstration exists that needs skilled work to use." .
nist_nvd:CvssExploitCodeMaturity\#UNPROVEN a owl:Class ;
	rdfs:label "UNPROVEN" ;
	rdfs:subClassOf nist_nvd:CvssExploitCodeMaturity ;
	skos:definition "No attack code is known, or the attack is only theory." .
nist_nvd:CvssExploitCodeMaturity a owl:Class ;
	rdfs:label "CvssExploitCodeMaturity" ;
	owl:unionOf _:c14n546 ;
	skos:definition "How far working attack code has come." ;
	skos:inScheme <https://w3id.org/lmodel/cve/cve_cvss> ;
	linkml:permissible_values nist_nvd:CvssExploitCodeMaturity\#FUNCTIONAL , nist_nvd:CvssExploitCodeMaturity\#HIGH , nist_nvd:CvssExploitCodeMaturity\#NOT_DEFINED , nist_nvd:CvssExploitCodeMaturity\#PROOF_OF_CONCEPT , nist_nvd:CvssExploitCodeMaturity\#UNPROVEN ;
	nist_nvd:upstream_path "imports/cvss/cvss-v2.0.json#/definitions/exploitabilityType imports/cvss/cvss-v3.0.json#/definitions/exploitCodeMaturityType imports/cvss/cvss-v3.1.json#/definitions/exploitCodeMaturityType" .
nist_nvd:CvssImpact\#HIGH a owl:Class ;
	rdfs:label "HIGH" ;
	rdfs:subClassOf nist_nvd:CvssImpact ;
	skos:definition "All of it is lost, or the loss has serious consequences." .
nist_nvd:CvssImpact\#LOW a owl:Class ;
	rdfs:label "LOW" ;
	rdfs:subClassOf nist_nvd:CvssImpact ;
	skos:definition "Some is lost, with limited consequences." .
nist_nvd:CvssImpact\#NONE a owl:Class ;
	rdfs:label "NONE" ;
	rdfs:subClassOf nist_nvd:CvssImpact ;
	skos:definition "Nothing is lost." .
nist_nvd:CvssImpact a owl:Class ;
	rdfs:label "CvssImpact" ;
	owl:unionOf _:c14n588 ;
	skos:definition "How much of one security property an attack could cost." ;
	skos:inScheme <https://w3id.org/lmodel/cve/cve_cvss> ;
	linkml:permissible_values nist_nvd:CvssImpact\#HIGH , nist_nvd:CvssImpact\#LOW , nist_nvd:CvssImpact\#NONE ;
	nist_nvd:upstream_path "imports/cvss/cvss-v3.0.json#/definitions/ciaType imports/cvss/cvss-v3.1.json#/definitions/ciaType imports/cvss/cvss-v4.0.json#/definitions/vulnCiaType imports/cvss/cvss-v4.0.json#/definitions/subCiaType" .
nist_nvd:CvssModifiedAttackComplexity\#HIGH a owl:Class ;
