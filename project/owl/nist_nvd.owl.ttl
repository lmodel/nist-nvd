	skos:definition "One answer on the way through a decision tree, keyed by its decision point." ;
	skos:inScheme nist_nvd:nvd_cve ;
	skos:note "NVD's file allows any key, with a string or a list of strings as its value, and extra_slots states that. The real data holds one key per object, and only these three, each with a string. They are named here because LinkML's Pydantic generator ignores extra_slots, so without them the Pydantic model refuses every SSVC decision." ;
	nist_nvd:upstream_definition "ssvc-v2.0.3.json#/properties/options/items" .
nist_nvd:NvdVendorComment a owl:Class ;
	rdfs:label "NvdVendorComment" ;
	rdfs:subClassOf _:c14n139 , _:c14n44 , _:c14n483 , _:c14n658 , _:c14n701 , _:c14n755 , _:c14n858 , _:c14n88 , _:c14n900 ;
	skos:altLabel "vendorComment" ;
	skos:closeMatch <http://schema.org/Comment> ;
	skos:definition "What a product's vendor has said about a vulnerability." ;
	skos:inScheme nist_nvd:nvd_cve ;
	nist_nvd:upstream_definition "cve_api_json_2.0.schema#/definitions/vendorComment" .
nist_nvd:NvdVersionChange a owl:Class ;
	rdfs:label "NvdVersionChange" ;
	rdfs:subClassOf _:c14n247 , _:c14n252 , _:c14n475 , _:c14n505 , _:c14n605 , _:c14n860 ;
	skos:closeMatch <https://w3id.org/lmodel/cve/CveVersionChange> ;
	skos:definition "A point within a range of versions where the status changes." ;
	skos:inScheme nist_nvd:nvd_cve ;
	nist_nvd:upstream_definition "cve_affected_1.0.json#/properties/versions/items/properties/changes/items" .
nist_nvd:NvdVersionStatus\#affected a owl:Class ;
	rdfs:label "affected" ;
	rdfs:subClassOf nist_nvd:NvdVersionStatus ;
	skos:definition "This version has the vulnerability." .
nist_nvd:NvdVersionStatus\#unaffected a owl:Class ;
	rdfs:label "unaffected" ;
	rdfs:subClassOf nist_nvd:NvdVersionStatus ;
	skos:definition "This version does not have the vulnerability." .
nist_nvd:NvdVersionStatus\#unknown a owl:Class ;
	rdfs:label "unknown" ;
	rdfs:subClassOf nist_nvd:NvdVersionStatus ;
	skos:definition "Nobody has said whether this version has the vulnerability." .
nist_nvd:NvdVersionStatus a owl:Class ;
	rdfs:label "NvdVersionStatus" ;
	owl:unionOf _:c14n265 ;
	skos:definition "Whether a version of a product has the vulnerability." ;
	skos:inScheme nist_nvd:nvd_cve ;
	linkml:permissible_values nist_nvd:NvdVersionStatus\#affected , nist_nvd:NvdVersionStatus\#unaffected , nist_nvd:NvdVersionStatus\#unknown .
nist_nvd:NvdVulnStatus\#Analyzed a owl:Class ;
	rdfs:label "Analyzed" ;
	rdfs:subClassOf nist_nvd:NvdVulnStatus ;
	skos:definition "NVD has finished its analysis of the record." .
nist_nvd:NvdVulnStatus\#Awaiting\%20Analysis a owl:Class ;
	rdfs:label "Awaiting Analysis" ;
	rdfs:subClassOf nist_nvd:NvdVulnStatus ;
	skos:definition "NVD has the record and has not begun to analyse it." .
nist_nvd:NvdVulnStatus\#Deferred a owl:Class ;
	rdfs:label "Deferred" ;
	rdfs:subClassOf nist_nvd:NvdVulnStatus ;
	skos:definition "NVD has put off analysing the record." .
nist_nvd:NvdVulnStatus\#Modified a owl:Class ;
	rdfs:label "Modified" ;
	rdfs:subClassOf nist_nvd:NvdVulnStatus ;
	skos:definition "The record has changed since NVD analysed it." .
nist_nvd:NvdVulnStatus\#Received a owl:Class ;
	rdfs:label "Received" ;
	rdfs:subClassOf nist_nvd:NvdVulnStatus ;
	skos:definition "The record has just reached NVD." .
nist_nvd:NvdVulnStatus\#Rejected a owl:Class ;
	rdfs:label "Rejected" ;
	rdfs:subClassOf nist_nvd:NvdVulnStatus ;
	skos:definition "The CVE identifier has been rejected." .
nist_nvd:NvdVulnStatus\#Undergoing\%20Analysis a owl:Class ;
	rdfs:label "Undergoing Analysis" ;
	rdfs:subClassOf nist_nvd:NvdVulnStatus ;
	skos:definition "NVD is analysing the record now." .
nist_nvd:NvdVulnStatus a owl:Class ;
	rdfs:label "NvdVulnStatus" ;
	owl:unionOf _:c14n309 ;
	skos:definition "Where a vulnerability stands in NVD's own analysis." ;
	skos:inScheme nist_nvd:nvd_cve ;
	skos:note "NVD's schema says only that vulnStatus is a string. This list comes from the data: the seven values of the 33,378 records read on 2026-11-03, which are the modified feed, the records the API marks as known exploited, and eight pages of its results spread across all its years. NVD's page that defines them refuses a plain client, so each description says only what the value's name and the data show. A new value fails validation, and the feed test reports it." ;
	linkml:permissible_values nist_nvd:NvdVulnStatus\#Analyzed , nist_nvd:NvdVulnStatus\#Awaiting\%20Analysis , nist_nvd:NvdVulnStatus\#Deferred , nist_nvd:NvdVulnStatus\#Modified , nist_nvd:NvdVulnStatus\#Received , nist_nvd:NvdVulnStatus\#Rejected , nist_nvd:NvdVulnStatus\#Undergoing\%20Analysis .
nist_nvd:NvdVulnerability a owl:Class ;
	rdfs:label "NvdVulnerability" ;
	rdfs:subClassOf _:c14n201 , _:c14n601 , _:c14n968 ;
	skos:altLabel "def_cve_item" ;
	skos:closeMatch <http://schema.org/DataFeedItem> ;
	skos:definition "One entry of a response, which only wraps the vulnerability." ;
	skos:inScheme nist_nvd:nvd_cve ;
	nist_nvd:upstream_definition "cve_api_json_2.0.schema#/definitions/def_cve_item" .
nist_nvd:NvdWeakness a owl:Class ;
	rdfs:label "NvdWeakness" ;
	rdfs:subClassOf _:c14n251 , _:c14n282 , _:c14n383 , _:c14n530 , _:c14n548 , _:c14n59 , _:c14n834 , _:c14n840 ;
	skos:altLabel "weakness" ;
	skos:closeMatch <https://w3id.org/lmodel/cve/CveProblemType> ;
	skos:definition "The weaknesses that one source says lie behind a vulnerability." ;
	skos:inScheme nist_nvd:nvd_cve ;
	nist_nvd:upstream_definition "cve_api_json_2.0.schema#/definitions/weakness" .
nist_nvd:acInsufInfo a owl:DatatypeProperty ;
	rdfs:label "acInsufInfo" ;
	skos:definition "Whether NVD lacked the information to rate the access complexity." ;
	skos:inScheme nist_nvd:nvd_cve .
nist_nvd:action a owl:DatatypeProperty ;
	rdfs:label "action" ;
	skos:definition "How the data changed, such as Added." ;
	skos:inScheme nist_nvd:nvd_history .
nist_nvd:affected a owl:ObjectProperty ;
	rdfs:label "affected" ;
	skos:closeMatch <https://w3id.org/lmodel/cve/affected> ;
	skos:definition "The affected products, by the source that names them." ;
	skos:inScheme nist_nvd:nvd_cve .
nist_nvd:affectedData a owl:ObjectProperty ;
	rdfs:label "affectedData" ;
	skos:definition "The products." ;
	skos:inScheme nist_nvd:nvd_cve .
nist_nvd:at a owl:DatatypeProperty ;
	rdfs:label "at" ;
	rdfs:range _:c14n810 ;
	skos:definition "The version at which the status changes." ;
	skos:inScheme nist_nvd:nvd_cve .
nist_nvd:automatable a owl:DatatypeProperty ;
	rdfs:label "automatable" ;
	skos:definition "Whether an attacker could automate the attack, as yes or no." ;
	skos:editorialNote "CVSS 4.0's Automatable differs from this key only by case, so the two share one page of the generated docs on a case-insensitive filesystem. Both are real keys, so neither is renamed, and tests/test_schema_rules.py pins this as the one such pair." ;
	skos:inScheme nist_nvd:nvd_cve .
nist_nvd:baseSeverity a owl:ObjectProperty ;
	rdfs:label "baseSeverity" ;
	skos:closeMatch <http://w3id.org/sepses/vocab/ref/cvss#severity> ;
	skos:definition "The severity band of the base score, which CVSS 2.0 leaves to NVD." ;
	skos:inScheme nist_nvd:nvd_cve .
nist_nvd:change a owl:ObjectProperty ;
	rdfs:label "change" ;
	skos:definition "The change." ;
	skos:inScheme nist_nvd:nvd_history .
nist_nvd:changes a owl:ObjectProperty ;
	rdfs:label "changes" ;
	skos:definition "Where the status changes within the range." ;
	skos:inScheme nist_nvd:nvd_cve .
nist_nvd:cisaActionDue a owl:DatatypeProperty ;
	rdfs:label "cisaActionDue" ;
	skos:definition "The day by which CISA says federal agencies must act." ;
	skos:exactMatch <https://w3id.org/lmodel/kev-catalog/dueDate> ;
	skos:inScheme nist_nvd:nvd_cve ;
	skos:note "Equal to the catalog's value for all 1,766 entries of the catalog of 2026-11-03, read through the API." .
nist_nvd:cisaExploitAdd a owl:DatatypeProperty ;
	rdfs:label "cisaExploitAdd" ;
	skos:definition "The day CISA added this vulnerability to its Known Exploited Vulnerabilities catalog." ;
	skos:exactMatch <https://w3id.org/lmodel/kev-catalog/dateAdded> ;
	skos:inScheme nist_nvd:nvd_cve ;
	skos:note "Equal to the catalog's value for all 1,766 entries of the catalog of 2026-11-03, read through the API." .
nist_nvd:cisaRequiredAction a owl:DatatypeProperty ;
	rdfs:label "cisaRequiredAction" ;
	skos:definition "What CISA says agencies must do about this vulnerability." ;
	skos:exactMatch <https://w3id.org/lmodel/kev-catalog/requiredAction> ;
	skos:inScheme nist_nvd:nvd_cve ;
	skos:note "Equal to the catalog's value for all 1,766 entries of the catalog of 2026-11-03, read through the API." .
nist_nvd:cisaVulnerabilityName a owl:DatatypeProperty ;
	rdfs:label "cisaVulnerabilityName" ;
	skos:definition "The name CISA gives this vulnerability in its catalog." ;
	skos:exactMatch <https://w3id.org/lmodel/kev-catalog/vulnerabilityName> ;
	skos:inScheme nist_nvd:nvd_cve ;
	skos:note "Equal to the catalog's value for all 1,766 entries of the catalog of 2026-11-03, read through the API." .
nist_nvd:collectionURL a owl:DatatypeProperty ;
	rdfs:label "collectionURL" ;
	skos:closeMatch <https://w3id.org/lmodel/cve/collectionURL> ;
	skos:definition "The address of the package collection that holds the product." ;
	skos:inScheme nist_nvd:nvd_cve .
nist_nvd:comment a owl:DatatypeProperty ;
	rdfs:label "comment" ;
	skos:definition "What the vendor said." ;
	skos:inScheme nist_nvd:nvd_cve .
nist_nvd:computed a owl:DatatypeProperty ;
	rdfs:label "computed" ;
	skos:definition "The decision in a short form." ;
	skos:inScheme nist_nvd:nvd_cve .
nist_nvd:configurations a owl:ObjectProperty ;
	rdfs:label "configurations" ;
	skos:closeMatch <http://w3id.org/sepses/vocab/ref/cve#hasVulnerableConfiguration> , <https://w3id.org/lmodel/cve/cpeApplicability> ;
	skos:definition "The product configurations that have the vulnerability." ;
	skos:inScheme nist_nvd:nvd_cve .
nist_nvd:cpe a owl:ObjectProperty ;
	rdfs:label "cpe" ;
	skos:definition "The CPE name and what NVD holds about it." ;
	skos:inScheme nist_nvd:nvd_cpe .
nist_nvd:cpeLastModified a owl:DatatypeProperty ;
	rdfs:label "cpeLastModified" ;
	skos:definition "When NVD last changed the list of CPE names this matches." ;
	skos:inScheme nist_nvd:nvd_cpematch .
nist_nvd:cpeMatch a owl:ObjectProperty ;
	rdfs:label "cpeMatch" ;
	skos:definition "The CPE matches of this part." ;
	skos:inScheme nist_nvd:nvd_cve .
nist_nvd:cpeName a owl:DatatypeProperty ;
	rdfs:label "cpeName" ;
	skos:definition "A Common Platform Enumeration (CPE) name, in its 2.3 formatted string." ;
	skos:inScheme nist_nvd:nvd_core ;
	skos:note "SPDX 3.0.1 names CPE 2.3 as one kind of external identifier. That term is the kind, not a property that holds the name, so it is only related." ;
	skos:relatedMatch <https://spdx.org/rdf/3.0.1/terms/Core/ExternalIdentifierType/cpe23> .
nist_nvd:cpeNameId a owl:DatatypeProperty ;
	rdfs:label "cpeNameId" ;
	rdfs:range xsd:string ;
	skos:definition "The UUID that NVD gives a CPE name." ;
	skos:inScheme nist_nvd:nvd_core .
nist_nvd:cpes a owl:DatatypeProperty ;
	rdfs:label "cpes" ;
	skos:closeMatch <https://w3id.org/lmodel/cve/cpes> ;
	skos:definition "The product's CPE names, in the 2.2 or the 2.3 form." ;
	skos:inScheme nist_nvd:nvd_cve ;
	skos:note "NVD's own pattern, with its quotes written as \\x22 and \\x27, which mean the same. The Python generators cut a raw string at a quote." .
nist_nvd:created a owl:DatatypeProperty ;
	rdfs:label "created" ;
	rdfs:range xsd:dateTime ;
	skos:closeMatch dcterms:created ;
	skos:definition "When NVD first recorded this." ;
	skos:inScheme nist_nvd:nvd_core .
nist_nvd:criteria a owl:DatatypeProperty ;
	rdfs:label "criteria" ;
	skos:definition "A CPE match string, which may hold wildcards." ;
	skos:inScheme nist_nvd:nvd_core .
nist_nvd:cve a owl:ObjectProperty ;
	rdfs:label "cve" ;
	skos:definition "The vulnerability." ;
	skos:inScheme nist_nvd:nvd_cve .
nist_nvd:cveChangeId a owl:DatatypeProperty ;
	rdfs:label "cveChangeId" ;
