	skos:inScheme nist_nvd:nvd_cpe .
nist_nvd:repo a owl:DatatypeProperty ;
	rdfs:label "repo" ;
	skos:closeMatch <https://w3id.org/lmodel/cve/repo> ;
	skos:definition "The address of the product's source code repository." ;
	skos:inScheme nist_nvd:nvd_cve ;
	skos:note "NVD's file says format uri. Some records write an address that RFC 3986 refuses, such as git://git@gitlab.com:gitlab-org/gitlab.git, so this is a string and tests/test_upstream.py lists the departure." .
