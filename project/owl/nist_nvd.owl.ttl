	skos:inScheme nist_nvd:nvd_cve .
nist_nvd:options a owl:ObjectProperty ;
	rdfs:label "options" ;
	skos:definition "The answers given, each as a decision point and its value." ;
	skos:inScheme nist_nvd:nvd_cve .
nist_nvd:organization a owl:DatatypeProperty ;
	rdfs:label "organization" ;
	skos:definition "The vendor's name." ;
