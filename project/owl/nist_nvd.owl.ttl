	nist_nvd:upstream_path "imports/cvss/cvss-v2.0.json#/properties/availabilityImpact imports/cvss/cvss-v3.0.json#/properties/availabilityImpact imports/cvss/cvss-v3.1.json#/properties/availabilityImpact" .
<https://w3id.org/lmodel/cve/availabilityRequirement> a owl:DatatypeProperty ;
	rdfs:label "availabilityRequirement" ;
	skos:definition "How much availability matters to the scorer for the affected system." ;
	skos:inScheme <https://w3id.org/lmodel/cve/cve_cvss> ;
