	skos:closeMatch <https://w3id.org/lmodel/cve/CveProductVersion> ;
	skos:definition "The status of one version of a product, or of a range of its versions." ;
	skos:editorialNote "These four rules state the oneOf of NVD's file, which has four branches: a version and a status alone, those with a numbering scheme, and those with a scheme and one of the two limits." ;
	skos:inScheme nist_nvd:nvd_cve ;
	nist_nvd:upstream_definition "cve_affected_1.0.json#/properties/versions/items" .
