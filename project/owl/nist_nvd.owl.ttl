@prefix WIKIDATA: <https://www.wikidata.org/wiki/> .
@prefix core: <https://w3id.org/lmodel/vulnerability-core/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix nvd: <https://w3id.org/lmodel/nist-nvd/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/lmodel/nist-nvd.owl.ttl> a owl:Ontology ;
    rdfs:label "nist-nvd" ;
    dct:license "Apache-2.0" ;
    dct:source <https://nvd.nist.gov/vuln/data-feeds> ;
    dct:title "nist-nvd" ;
    rdfs:seeAlso <https://csrc.nist.gov/schema/nvd/api/2.0/cve_api_json_2.0.schema>,
        <https://lmodel.github.io/nist-nvd>,
        <https://nvd.nist.gov/general/visualizations/vulnerability-visualizations/cve-status-waterfall>,
        <https://nvd.nist.gov/vuln/detail> ;
    skos:definition """NIST National Vulnerability Database (NVD) LinkML Schema.
Captures enriched vulnerability records, CVSS metric views, CPE
applicability statements, weakness attributions, reference resource tags,
KEV indicator details, and NVD lifecycle status transitions.""" ;
    nvd:cwe_view "CWE-1003" ;
    nvd:source_context "NVD Vulnerability Detail Pages and Vulnerability Status pages" ;
    nvd:source_features "current_description,analysis_description,cvss_tabs,reference_resource_tags,cpe_configuration_types,kev_banner,weakness_source_table,status_flow" .

nvd:NVDEntry a owl:Class ;
    rdfs:label "NVDEntry" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nvd:metrics ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nvd:date_received ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nvd:status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nvd:known_exploited ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nvd:description_source ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nvd:description_source ],
        [ a owl:Restriction ;
            owl:allValuesFrom nvd:NVDWorkflowStatus ;
            owl:onProperty nvd:workflow_status ],
        [ a owl:Restriction ;
            owl:allValuesFrom nvd:NVDWorkflowStatus ;
            owl:onProperty nvd:status ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty core:weaknesses ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nvd:vendor_comments ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nvd:date_received ],
        [ a owl:Restriction ;
            owl:allValuesFrom nvd:CPEConfiguration ;
            owl:onProperty nvd:configurations ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nvd:cwe_view ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nvd:analysis_description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nvd:workflow_status ],
        [ a owl:Restriction ;
            owl:allValuesFrom nvd:StatusTransition ;
            owl:onProperty nvd:status_transitions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nvd:nvd_tags ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nvd:cwe_view ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nvd:cve_tags ],
        [ a owl:Restriction ;
            owl:allValuesFrom nvd:NVDTag ;
            owl:onProperty nvd:nvd_tags ],
        [ a owl:Restriction ;
            owl:allValuesFrom nvd:VendorComment ;
            owl:onProperty nvd:vendor_comments ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nvd:analysis_description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nvd:status ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nvd:cwe_view ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nvd:description_source ],
        [ a owl:Restriction ;
            owl:allValuesFrom nvd:NVDWeakness ;
            owl:onProperty core:weaknesses ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nvd:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom nvd:KnownExploitedVulnerability ;
            owl:onProperty nvd:known_exploited ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nvd:metrics ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nvd:analysis_description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nvd:workflow_status ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nvd:configurations ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty core:references ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty nvd:date_received ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty nvd:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nvd:cve_tags ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nvd:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom nvd:NVDReference ;
            owl:onProperty core:references ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nvd:known_exploited ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nvd:status_transitions ],
        [ a owl:Restriction ;
            owl:allValuesFrom nvd:MetricSet ;
            owl:onProperty nvd:metrics ],
        core:Vulnerability ;
    skos:definition "Enriched NVD representation of a CVE entry." ;
    skos:editorialNote "If NVD and CNA CVSS values match, NVD displays only the CNA values.",
        "Rejected CVEs are determined by the CVE Program rather than NVD." ;
    skos:exactMatch WIKIDATA:Q631425 ;
    skos:inScheme <https://w3id.org/lmodel/nist-nvd> ;
    skos:note "Analysis Description captures the description present when NVD enrichment occurred.",
        "Current Description is the currently visible CVE description." .

core:Configuration a owl:Class ;
    rdfs:label "Configuration" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty core:cpe_uri ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty core:operator ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty core:operator ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty core:cpe_uri ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty core:operator ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty core:cpe_uri ] ;
    skos:definition "Logical grouping of CPE match expressions." ;
    skos:inScheme <https://w3id.org/lmodel/vulnerability-core> .

nvd:NVDReference a owl:Class ;
    rdfs:label "NVDReference" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nvd:url ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nvd:source ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nvd:source ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nvd:resource_tags ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty nvd:url ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nvd:url ],
        [ a owl:Restriction ;
            owl:allValuesFrom nvd:ReferenceTag ;
            owl:onProperty nvd:resource_tags ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nvd:source ],
        core:Reference ;
    skos:definition "Reference URL with NVD resource tags." ;
    skos:inScheme <https://w3id.org/lmodel/nist-nvd> .

nvd:NVDWeakness a owl:Class ;
    rdfs:label "NVDWeakness" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nvd:cwe_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nvd:name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty nvd:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty core:source ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty nvd:cwe_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty core:source ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty core:source ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nvd:cwe_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nvd:name ],
        core:Weakness ;
    skos:definition "Weakness row as presented on the NVD detail page." ;
    skos:inScheme <https://w3id.org/lmodel/nist-nvd> ;
    skos:note "NVD uses CWE-1003 for simplified mapping of published vulnerabilities." .

core:Vulnerability a owl:Class ;
    rdfs:label "Vulnerability" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty core:products ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty core:last_modified_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom core:Product ;
            owl:onProperty core:products ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty core:cve_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty core:impact ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty core:cve_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty core:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty core:title ],
        [ a owl:Restriction ;
            owl:allValuesFrom core:Reference ;
            owl:onProperty core:references ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty core:impact ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty core:last_modified_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty core:references ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty core:published_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty core:weaknesses ],
        [ a owl:Restriction ;
            owl:allValuesFrom core:Weakness ;
            owl:onProperty core:weaknesses ],
        [ a owl:Restriction ;
            owl:allValuesFrom core:Impact ;
            owl:onProperty core:impact ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty core:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty core:status ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty core:published_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom nvd:VulnerabilityStatus ;
            owl:onProperty core:status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty core:title ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty core:published_date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty core:last_modified_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty core:title ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty core:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty core:status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty core:cve_id ] ;
    skos:definition "Abstract base representation of a security vulnerability. Extended by source-specific schemas (KEV, CVE, NVD)." ;
    skos:exactMatch WIKIDATA:Q631425 ;
    skos:inScheme <https://w3id.org/lmodel/vulnerability-core> ;
    skos:relatedMatch schema1:SoftwareApplication .

nvd:CPEMatch a owl:Class ;
    rdfs:label "CPEMatch" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nvd:version_start_excluding ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nvd:version_start_excluding ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nvd:cpe23_uri ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nvd:match_criteria_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nvd:cpe23_uri ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nvd:criteria ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nvd:criteria ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nvd:version_end_including ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nvd:version_end_excluding ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nvd:match_criteria_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nvd:version_end_including ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nvd:version_start_including ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nvd:vulnerable ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty nvd:vulnerable ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nvd:vulnerable ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nvd:cpe23_uri ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nvd:version_end_excluding ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nvd:version_end_excluding ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nvd:version_start_including ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nvd:match_criteria_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nvd:version_end_including ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nvd:matched_cpe_names ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nvd:criteria ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nvd:matched_cpe_names ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nvd:version_start_including ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nvd:version_start_excluding ] ;
    skos:definition "Leaf-level CPE match criterion and optional version bounds." ;
    skos:editorialNote "Matching CPE names can be exposed in expanded detail-page sections." ;
    skos:inScheme <https://w3id.org/lmodel/nist-nvd> .

nvd:CVSSScoreNote a owl:Class ;
    rdfs:label "CVSSScoreNote" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nvd:message ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty core:source ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nvd:message ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty nvd:created ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty nvd:note_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nvd:created ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nvd:note_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nvd:message ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nvd:note_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nvd:created ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty core:source ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty core:source ] ;
    skos:definition "Additional explanatory note for CVSS display conditions." ;
    skos:inScheme <https://w3id.org/lmodel/nist-nvd> .

<https://w3id.org/lmodel/nist-nvd/CVSSVersion#V2_0> a owl:Class ;
    rdfs:label "V2_0" ;
    rdfs:subClassOf nvd:CVSSVersion .

<https://w3id.org/lmodel/nist-nvd/CVSSVersion#V3_0> a owl:Class ;
    rdfs:label "V3_0" ;
    rdfs:subClassOf nvd:CVSSVersion .

<https://w3id.org/lmodel/nist-nvd/CVSSVersion#V3_1> a owl:Class ;
    rdfs:label "V3_1" ;
    rdfs:subClassOf nvd:CVSSVersion .

<https://w3id.org/lmodel/nist-nvd/CVSSVersion#V4_0> a owl:Class ;
    rdfs:label "V4_0" ;
    rdfs:subClassOf nvd:CVSSVersion .

<https://w3id.org/lmodel/nist-nvd/ConfigurationType#ADVANCED> a owl:Class ;
    rdfs:label "ADVANCED" ;
    rdfs:subClassOf nvd:ConfigurationType .

<https://w3id.org/lmodel/nist-nvd/ConfigurationType#BASIC> a owl:Class ;
    rdfs:label "BASIC" ;
    rdfs:subClassOf nvd:ConfigurationType .

<https://w3id.org/lmodel/nist-nvd/ConfigurationType#RUNNING_ON_WITH> a owl:Class ;
    rdfs:label "RUNNING_ON_WITH" ;
    rdfs:subClassOf nvd:ConfigurationType .

<https://w3id.org/lmodel/nist-nvd/ImpactSeverity#CRITICAL> a owl:Class ;
    rdfs:label "CRITICAL" ;
    rdfs:subClassOf nvd:ImpactSeverity ;
    skos:definition "Critical impact; complete compromise; remote exploitation likely." .

<https://w3id.org/lmodel/nist-nvd/ImpactSeverity#HIGH> a owl:Class ;
    rdfs:label "HIGH" ;
    rdfs:subClassOf nvd:ImpactSeverity ;
    skos:definition "High impact; significant compromise of security properties." .

<https://w3id.org/lmodel/nist-nvd/ImpactSeverity#LOW> a owl:Class ;
    rdfs:label "LOW" ;
    rdfs:subClassOf nvd:ImpactSeverity ;
    skos:definition "Limited impact; exploitation requires specific conditions." .

<https://w3id.org/lmodel/nist-nvd/ImpactSeverity#MEDIUM> a owl:Class ;
    rdfs:label "MEDIUM" ;
    rdfs:subClassOf nvd:ImpactSeverity ;
    skos:definition "Moderate impact; partial compromise of security properties." .

<https://w3id.org/lmodel/nist-nvd/ImpactSeverity#NONE> a owl:Class ;
    rdfs:label "NONE" ;
    rdfs:subClassOf nvd:ImpactSeverity ;
    skos:definition "No measurable impact." .

<https://w3id.org/lmodel/nist-nvd/ImpactSeverity#UNKNOWN> a owl:Class ;
    rdfs:label "UNKNOWN" ;
    rdfs:subClassOf nvd:ImpactSeverity ;
    skos:definition "Severity has not been assessed or is unavailable." .

nvd:KnownExploitedVulnerability a owl:Class ;
    rdfs:label "KnownExploitedVulnerability" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nvd:required_action ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty nvd:date_added ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nvd:kev_reference ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nvd:kev_reference ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nvd:due_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nvd:due_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty nvd:kev_reference ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nvd:date_added ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty nvd:due_date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nvd:required_action ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nvd:date_added ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nvd:required_action ] ;
    skos:definition "CISA KEV information rendered on the NVD detail page." ;
    skos:editorialNote "Present only when the CVE appears in the CISA Known Exploited Vulnerabilities catalog." ;
    skos:inScheme <https://w3id.org/lmodel/nist-nvd> .

nvd:MetricSet a owl:Class ;
    rdfs:label "MetricSet" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom nvd:CVSSScoreNote ;
            owl:onProperty nvd:score_notes ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nvd:cvss_v2_metrics ],
        [ a owl:Restriction ;
            owl:allValuesFrom nvd:CVSSMetric ;
            owl:onProperty nvd:cvss_v3_metrics ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nvd:cvss_v4_metrics ],
        [ a owl:Restriction ;
            owl:allValuesFrom nvd:CVSSMetric ;
            owl:onProperty nvd:cvss_v4_metrics ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nvd:score_notes ],
        [ a owl:Restriction ;
            owl:allValuesFrom nvd:CVSSMetric ;
            owl:onProperty nvd:cvss_v2_metrics ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nvd:cvss_v3_metrics ] ;
    skos:definition "Container for all metric views across CVSS versions." ;
    skos:inScheme <https://w3id.org/lmodel/nist-nvd> ;
    skos:note "NVD detail pages expose button toggles for CVSS v4.0, v3.x, and v2.0." .

<https://w3id.org/lmodel/nist-nvd/NVDTag#ADDITIONAL_INFORMATION> a owl:Class ;
    rdfs:label "ADDITIONAL_INFORMATION" ;
    rdfs:subClassOf nvd:NVDTag .

<https://w3id.org/lmodel/nist-nvd/NVDTag#ANALYSIS_PENDING> a owl:Class ;
    rdfs:label "ANALYSIS_PENDING" ;
    rdfs:subClassOf nvd:NVDTag .

