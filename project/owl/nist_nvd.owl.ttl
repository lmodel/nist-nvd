	skos:definition "The CVSS 3.1 scores." ;
	skos:inScheme nist_nvd:nvd_cve .
nist_nvd:cvssMetricV40 a owl:ObjectProperty ;
	rdfs:label "cvssMetricV40" ;
	skos:definition "The CVSS 4.0 scores." ;
	skos:inScheme nist_nvd:nvd_cve .
nist_nvd:decisionTree a owl:ObjectProperty ;
	rdfs:label "decisionTree" ;
	skos:definition "The whole tree this decision came from." ;
	skos:inScheme nist_nvd:nvd_cve .
nist_nvd:decisionTreeUrl a owl:DatatypeProperty ;
	rdfs:label "decisionTreeUrl" ;
	skos:definition "Where to find the tree this decision came from." ;
	skos:inScheme nist_nvd:nvd_cve .
nist_nvd:defaultStatus a owl:ObjectProperty ;
	rdfs:label "defaultStatus" ;
	rdfs:range nist_nvd:NvdVersionStatus ;
	skos:definition "The status of any version the versions list does not name." ;
	skos:inScheme nist_nvd:nvd_cve .
nist_nvd:deprecated a owl:DatatypeProperty ;
	rdfs:label "deprecated" ;
	skos:definition "Whether NVD has retired this CPE name." ;
	skos:inScheme nist_nvd:nvd_cpe .
nist_nvd:deprecatedBy a owl:ObjectProperty ;
	rdfs:label "deprecatedBy" ;
	skos:closeMatch dcterms:isReplacedBy ;
	skos:definition "The CPE names that replace this one." ;
	skos:inScheme nist_nvd:nvd_cpe .
nist_nvd:deprecates a owl:ObjectProperty ;
	rdfs:label "deprecates" ;
	skos:closeMatch dcterms:replaces ;
	skos:definition "The CPE names this one replaces." ;
	skos:inScheme nist_nvd:nvd_cpe .
nist_nvd:description a owl:ObjectProperty ;
	rdfs:label "description" ;
	rdfs:range nist_nvd:NvdLangString ;
	skos:definition "The weakness, as language-tagged text, usually a CWE identifier." ;
	skos:inScheme nist_nvd:nvd_cve .
nist_nvd:descriptions a owl:ObjectProperty ;
	rdfs:label "descriptions" ;
	skos:closeMatch <https://w3id.org/lmodel/cve/descriptions> ;
	skos:definition "What the vulnerability is, in one or more languages." ;
	skos:inScheme nist_nvd:nvd_cve .
nist_nvd:details a owl:ObjectProperty ;
	rdfs:label "details" ;
	skos:definition "What the change did, part by part." ;
	skos:inScheme nist_nvd:nvd_history .
nist_nvd:evaluatorComment a owl:DatatypeProperty ;
	rdfs:label "evaluatorComment" ;
	skos:definition "A remark from NVD's analyst." ;
	skos:inScheme nist_nvd:nvd_cve .
nist_nvd:evaluatorImpact a owl:DatatypeProperty ;
	rdfs:label "evaluatorImpact" ;
	skos:definition "What the vulnerability can lead to, from NVD's analyst." ;
	skos:inScheme nist_nvd:nvd_cve .
nist_nvd:evaluatorSolution a owl:DatatypeProperty ;
	rdfs:label "evaluatorSolution" ;
	skos:definition "A way to resolve the vulnerability, from NVD's analyst." ;
	skos:inScheme nist_nvd:nvd_cve .
nist_nvd:eventName a owl:DatatypeProperty ;
	rdfs:label "eventName" ;
	skos:definition "The kind of event, such as Initial Analysis or CVE Modified." ;
	skos:inScheme nist_nvd:nvd_history ;
	skos:note "NVD's schema says only that this is a string. The samples read here hold too little of a list of 2.4 million changes to close it, so it stays a string." .
nist_nvd:exploitabilityScore a owl:DatatypeProperty ;
	rdfs:label "exploitabilityScore" ;
	rdfs:range _:c14n229 ;
	skos:closeMatch <http://w3id.org/sepses/vocab/ref/cvss#exploitabilityScore> ;
	skos:definition "The CVSS exploitability subscore." ;
	skos:inScheme nist_nvd:nvd_cve .
nist_nvd:exploitation a owl:DatatypeProperty ;
	rdfs:label "exploitation" ;
	skos:definition "How far the vulnerability is known to be exploited, such as none, poc or active." ;
	skos:inScheme nist_nvd:nvd_cve .
nist_nvd:format a owl:DatatypeProperty ;
	rdfs:label "format" ;
	skos:definition "The name NVD gives this kind of response." ;
	skos:inScheme nist_nvd:nvd_core ;
	skos:note "NVD's schemas say only that this is a string. Each response class pins the one value the API's answers carry." .
nist_nvd:generator a owl:DatatypeProperty ;
	rdfs:label "generator" ;
	skos:definition "The tool that wrote this decision." ;
	skos:inScheme nist_nvd:nvd_cve .
nist_nvd:id a owl:DatatypeProperty ;
	rdfs:label "id" ;
	rdfs:range xsd:string ;
	skos:closeMatch dcterms:identifier ;
	skos:definition "The vulnerability the decision is about, by whatever identifier." , "The vulnerability's CVE identifier." ;
	skos:exactMatch <http://www.wikidata.org/prop/direct/P3587> , <https://w3id.org/lmodel/cve/cveId> , <https://w3id.org/lmodel/kev-catalog/cveID> ;
	skos:inScheme nist_nvd:nvd_cve ;
	skos:note "Every CVE identifier in the KEV catalog of 2026-11-03 is the id of one record the API marks as known exploited, and the reverse." , "Wikidata's P3587 holds the same identifier in the same form, on the item for the vulnerability." .
nist_nvd:impactScore a owl:DatatypeProperty ;
	rdfs:label "impactScore" ;
	rdfs:range _:c14n961 ;
	skos:closeMatch <http://w3id.org/sepses/vocab/ref/cvss#impactScore> ;
	skos:definition "The CVSS impact subscore." ;
	skos:inScheme nist_nvd:nvd_cve .
nist_nvd:lang a owl:DatatypeProperty ;
	rdfs:label "lang" ;
	skos:closeMatch dcterms:language , <http://schema.org/inLanguage> ;
	skos:definition "The language of the text beside it, as a language code." ;
	skos:inScheme nist_nvd:nvd_core .
nist_nvd:lastModified a owl:DatatypeProperty ;
	rdfs:label "lastModified" ;
	rdfs:range xsd:dateTime ;
	skos:closeMatch dcterms:modified , <http://schema.org/dateModified> ;
	skos:definition "When NVD last changed this." ;
	skos:inScheme nist_nvd:nvd_core ;
	skos:note "A CPE name, a match string and a vendor comment carry this too, so the mappings that hold only of a vulnerability sit on NvdCve's use of it." .
nist_nvd:lessThan a owl:DatatypeProperty ;
	rdfs:label "lessThan" ;
	skos:definition "The first version after the range." ;
	skos:inScheme nist_nvd:nvd_cve .
nist_nvd:lessThanOrEqual a owl:DatatypeProperty ;
	rdfs:label "lessThanOrEqual" ;
	skos:definition "The last version in the range." ;
	skos:inScheme nist_nvd:nvd_cve .
nist_nvd:matchCriteriaId a owl:DatatypeProperty ;
	rdfs:label "matchCriteriaId" ;
	rdfs:range xsd:string ;
	skos:definition "The UUID that NVD gives a CPE match string." ;
	skos:inScheme nist_nvd:nvd_core .
nist_nvd:matchString a owl:ObjectProperty ;
	rdfs:label "matchString" ;
	skos:definition "The match string and what NVD holds about it." ;
	skos:inScheme nist_nvd:nvd_cpematch .
nist_nvd:matchStrings a owl:ObjectProperty ;
	rdfs:label "matchStrings" ;
	skos:definition "The match strings on this page." ;
	skos:inScheme nist_nvd:nvd_cpematch .
nist_nvd:matches a owl:ObjectProperty ;
	rdfs:label "matches" ;
	skos:definition "The CPE names this matches." ;
	skos:inScheme nist_nvd:nvd_cpematch .
nist_nvd:metrics a owl:ObjectProperty ;
	rdfs:label "metrics" ;
	skos:closeMatch <https://w3id.org/lmodel/cve/metrics> ;
	skos:definition "The scores that NVD and others give this vulnerability." ;
	skos:inScheme nist_nvd:nvd_cve ;
	skos:relatedMatch <http://w3id.org/sepses/vocab/ref/cvss#hasCVSS> .
nist_nvd:modules a owl:DatatypeProperty ;
	rdfs:label "modules" ;
	skos:closeMatch <https://w3id.org/lmodel/cve/modules> ;
	skos:definition "The affected parts of the product." ;
	skos:inScheme nist_nvd:nvd_cve .
nist_nvd:name a owl:DatatypeProperty ;
	rdfs:label "name" ;
	rdfs:range _:c14n791 ;
	skos:definition "The name of the source code routine." ;
	skos:inScheme nist_nvd:nvd_cve .
nist_nvd:negate a owl:DatatypeProperty ;
	rdfs:label "negate" ;
	rdfs:range xsd:boolean ;
	skos:definition "Whether the result of the configuration is reversed." ;
