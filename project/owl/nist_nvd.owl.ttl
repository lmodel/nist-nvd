	skos:inScheme nist_nvd:nvd_history .
nist_nvd:cveChanges a owl:ObjectProperty ;
	rdfs:label "cveChanges" ;
	skos:definition "The changes on this page." ;
	skos:inScheme nist_nvd:nvd_history .
nist_nvd:cveId a owl:ObjectProperty ;
	rdfs:label "cveId" ;
	skos:definition "The vulnerability the change is to." ;
	skos:inScheme nist_nvd:nvd_history .
nist_nvd:cveTags a owl:ObjectProperty ;
	rdfs:label "cveTags" ;
	skos:closeMatch <https://w3id.org/lmodel/cve/tags> ;
