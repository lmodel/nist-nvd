nist_nvd:programFiles a owl:DatatypeProperty ;
	rdfs:label "programFiles" ;
	skos:closeMatch <https://w3id.org/lmodel/cve/programFiles> ;
	skos:definition "The affected source code files." ;
	skos:inScheme nist_nvd:nvd_cve .
nist_nvd:programRoutines a owl:ObjectProperty ;
	rdfs:label "programRoutines" ;
	skos:closeMatch <https://w3id.org/lmodel/cve/programRoutines> ;
	skos:definition "The affected source code routines." ;
	skos:inScheme nist_nvd:nvd_cve .
nist_nvd:published a owl:DatatypeProperty ;
	rdfs:label "published" ;
	skos:closeMatch dcterms:issued , <http://schema.org/datePublished> , <https://spdx.org/rdf/3.0.1/terms/Security/publishedTime> ;
	skos:definition "When NVD published this vulnerability." ;
	skos:inScheme nist_nvd:nvd_cve ;
	skos:note "This is NVD's own time, not the CVE record's datePublished. For CVE-2021-44228 the CVE record says 2021-12-10T00:00:00.000Z and NVD 2021-12-10T10:15:09.143, so the mapping is only a related one." ;
	skos:relatedMatch <https://w3id.org/lmodel/cve/datePublished> .
nist_nvd:ref a owl:DatatypeProperty ;
	rdfs:label "ref" ;
	skos:definition "The page's address." ;
	skos:inScheme nist_nvd:nvd_cpe ;
	skos:note "NVD's own pattern, with its single quote written as \\x27, which means the same. gen-python cuts a raw string at a single quote." .
nist_nvd:references a owl:ObjectProperty ;
	rdfs:label "references" ;
	rdfs:range nist_nvd:NvdReference ;
	skos:closeMatch <http://w3id.org/sepses/vocab/ref/cve#hasReference> , <https://w3id.org/lmodel/cve/references> ;
