	skos:inScheme <https://w3id.org/lmodel/cve/cve_cvss> ;
	nist_nvd:upstream_path "imports/cvss/cvss-v2.0.json#/properties/authentication" .
<https://w3id.org/lmodel/cve/availabilityImpact> a owl:DatatypeProperty ;
	rdfs:label "availabilityImpact" ;
	skos:closeMatch <http://w3id.org/sepses/vocab/ref/cvss#availabilityImpact> ;
