<https://w3id.org/lmodel/cve/Recovery> a owl:ObjectProperty ;
	rdfs:label "Recovery" ;
	skos:definition "How the affected system comes back after an attack." ;
	skos:inScheme <https://w3id.org/lmodel/cve/cve_cvss> ;
	nist_nvd:upstream_path "imports/cvss/cvss-v4.0.json#/properties/Recovery" .
<https://w3id.org/lmodel/cve/Safety> a owl:ObjectProperty ;
	rdfs:label "Safety" ;
	skos:definition "Whether an attack could put people's safety at risk." ;
	skos:inScheme <https://w3id.org/lmodel/cve/cve_cvss> ;
	nist_nvd:upstream_path "imports/cvss/cvss-v4.0.json#/properties/Safety" .
<https://w3id.org/lmodel/cve/accessComplexity> a owl:ObjectProperty ;
	rdfs:label "accessComplexity" ;
	skos:closeMatch <http://w3id.org/sepses/vocab/ref/cvss#accessComplexity> ;
	skos:definition "How hard the flaw is to use once the attacker can reach it." ;
	skos:inScheme <https://w3id.org/lmodel/cve/cve_cvss> ;
	nist_nvd:upstream_path "imports/cvss/cvss-v2.0.json#/properties/accessComplexity" .
<https://w3id.org/lmodel/cve/accessVector> a owl:ObjectProperty ;
	rdfs:label "accessVector" ;
	skos:closeMatch <http://w3id.org/sepses/vocab/ref/cvss#accessVector> ;
	skos:definition "How far away an attacker can be when using the flaw, in CVSS 2.0's terms." ;
	skos:inScheme <https://w3id.org/lmodel/cve/cve_cvss> ;
	nist_nvd:upstream_path "imports/cvss/cvss-v2.0.json#/properties/accessVector" .
<https://w3id.org/lmodel/cve/attackComplexity> a owl:DatatypeProperty ;
	rdfs:label "attackComplexity" ;
	skos:closeMatch <http://w3id.org/sepses/vocab/ref/cvss#attackComplexity> ;
	skos:definition "How much is outside the attacker's control when using the flaw." ;
	skos:inScheme <https://w3id.org/lmodel/cve/cve_cvss> ;
	nist_nvd:upstream_path "imports/cvss/cvss-v3.0.json#/properties/attackComplexity imports/cvss/cvss-v3.1.json#/properties/attackComplexity imports/cvss/cvss-v4.0.json#/properties/attackComplexity" .
<https://w3id.org/lmodel/cve/attackRequirements> a owl:ObjectProperty ;
	rdfs:label "attackRequirements" ;
	skos:definition "Whether the attack needs conditions in the target that the attacker does not control." ;
	skos:inScheme <https://w3id.org/lmodel/cve/cve_cvss> ;
	nist_nvd:upstream_path "imports/cvss/cvss-v4.0.json#/properties/attackRequirements" .
<https://w3id.org/lmodel/cve/attackVector> a owl:DatatypeProperty ;
	rdfs:label "attackVector" ;
	skos:closeMatch <http://w3id.org/sepses/vocab/ref/cvss#attackVector> ;
	skos:definition "How far away an attacker can be when using the flaw." ;
	skos:inScheme <https://w3id.org/lmodel/cve/cve_cvss> ;
	nist_nvd:upstream_path "imports/cvss/cvss-v3.0.json#/properties/attackVector imports/cvss/cvss-v3.1.json#/properties/attackVector imports/cvss/cvss-v4.0.json#/properties/attackVector" .
<https://w3id.org/lmodel/cve/authentication> a owl:ObjectProperty ;
	rdfs:label "authentication" ;
	skos:closeMatch <http://w3id.org/sepses/vocab/ref/cvss#authentication> ;
