	rdfs:subClassOf _:c14n1010 , _:c14n105 , _:c14n118 , _:c14n152 , _:c14n219 , _:c14n232 , _:c14n255 , _:c14n26 , _:c14n34 , _:c14n342 , _:c14n348 , _:c14n423 , _:c14n491 , _:c14n5 , _:c14n511 , _:c14n53 , _:c14n532 , _:c14n560 , _:c14n58 , _:c14n638 , _:c14n697 , _:c14n77 , _:c14n78 , _:c14n781 , _:c14n82 , _:c14n821 , _:c14n877 , _:c14n901 , _:c14n915 , _:c14n93 , _:c14n962 , _:c14n984 , _:c14n999 ;
	skos:closeMatch <https://w3id.org/lmodel/cve/CveProduct> ;
	skos:definition "A product and which of its versions have the vulnerability." ;
	skos:editorialNote "NVD's file has the same keys as the CVE Record Format's product. It drops the two rules that the CVE format states, that a product names a vendor and product or a collection and package, and that it has versions or a default status, so this class does not state them. The default status keeps NVD's own enum beside it, so nvd_cve needs no second copy of the CVE module." ;
	skos:inScheme nist_nvd:nvd_cve ;
	nist_nvd:upstream_definition "cve_affected_1.0.json#" .
